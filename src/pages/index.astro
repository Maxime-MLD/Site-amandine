---
import About from '../components/About.astro';
import PriseEnCharge from '../components/PriseEnCharge.astro';
import Contact from '../components/Contact.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import InformationsPratiques from '../components/InformationsPratiques.astro';
import Methode from '../components/Methode.astro';
import Navbar from '../components/Navbar.astro';
import Services from '../components/Services.astro';
import TrustBar from '../components/TrustBar.astro';
import PourQui from '../components/PourQui.astro';
import { homeSeo } from '../data/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeLocalBusinessSchema } from '../seo/schema';
---

<BaseLayout title={homeSeo.title} description={homeSeo.description} schema={homeLocalBusinessSchema}>
	<Navbar slot="header" />
	<Hero />
	<TrustBar />
	<Services />
	<About />
	<PourQui />
	<Methode />
	<PriseEnCharge />
	<InformationsPratiques />
	<Faq />
	<FinalCta />
	<Contact />
	<Footer slot="footer" />
	<script>
		import '../scripts/animations';
		import '../scripts/contact-form';
	</script>
</BaseLayout>
