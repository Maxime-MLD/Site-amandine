---
import { Image } from 'astro:assets';
import logoAmandine from '../assets/images/logo-amandine.png';
import { siteConfig } from '../config/site';
import { heroContent, navigation } from '../data/content';

const isHomePage = Astro.url.pathname === '/';
const homeAnchor = (href: string) => isHomePage ? href : `/${href}`;
---

<header class="site-header" data-site-header>
	<div class="site-container site-header__inner">
		<a class="brand" href={homeAnchor('#accueil')} aria-label={`${siteConfig.fullName}, accueil`}>
			<Image
				class="brand__logo"
				src={logoAmandine}
				alt={`${siteConfig.fullName} — ${siteConfig.profession}`}
				height={68}
				loading="eager"
				fetchpriority="high"
			/>
		</a>

		<nav class="desktop-navigation" aria-label="Navigation principale">
			<ul>
				{navigation.map((item) => (
					<li>
						<a href={homeAnchor(item.href)} aria-current={isHomePage && item.href === '#accueil' ? 'page' : undefined}>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<a class="navbar-cta" href={homeAnchor(heroContent.actions.primary.href)}>
			{heroContent.actions.primary.label}
		</a>

		<button
			class="menu-toggle"
			type="button"
			aria-label="Ouvrir le menu"
			aria-expanded="false"
			aria-controls="mobile-navigation"
			data-menu-toggle
		>
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
		</button>
	</div>

	<div class="mobile-menu" id="mobile-navigation" data-mobile-menu hidden>
		<nav class="site-container" aria-label="Navigation mobile">
			<ul>
				{navigation.map((item) => (
					<li><a href={homeAnchor(item.href)}>{item.label}</a></li>
				))}
			</ul>
			<a class="mobile-menu__cta" href={homeAnchor(heroContent.actions.primary.href)}>
				{heroContent.actions.primary.label}
			</a>
			<p class="mobile-menu__meta">
				<span>Montagny (42)</span>
				<span>Soins à domicile &amp; au cabinet</span>
			</p>
		</nav>
	</div>
</header>

<script>
	const siteHeader = document.querySelector<HTMLElement>('[data-site-header]');
	const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');
	const controller = new AbortController();

	const updateHeader = () => {
		siteHeader?.toggleAttribute('data-scrolled', window.scrollY > 24);
	};

	updateHeader();
	window.addEventListener('scroll', updateHeader, { passive: true, signal: controller.signal });

	if (menuToggle && mobileMenu) {
		const setMenuState = (isOpen: boolean) => {
			menuToggle.setAttribute('aria-expanded', String(isOpen));
			menuToggle.setAttribute('aria-label', isOpen ? 'Fermer le menu' : 'Ouvrir le menu');
			mobileMenu.hidden = !isOpen;
			document.body.classList.toggle('menu-is-open', isOpen);
		};

		menuToggle.addEventListener('click', () => {
			setMenuState(menuToggle.getAttribute('aria-expanded') !== 'true');
		}, { signal: controller.signal });

		mobileMenu.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
			link.addEventListener('click', () => setMenuState(false), { signal: controller.signal });
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menuToggle.getAttribute('aria-expanded') === 'true') {
				setMenuState(false);
				menuToggle.focus();
			}
		}, { signal: controller.signal });

		window.matchMedia('(min-width: 64rem)').addEventListener('change', (event) => {
			if (event.matches) setMenuState(false);
		}, { signal: controller.signal });
	}

	if (import.meta.hot) {
		import.meta.hot.dispose(() => controller.abort());
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		height: 96px;
		background: var(--bg-secondary);
		color: var(--c-petrol);
		transition: background-color 280ms ease, box-shadow 280ms ease, backdrop-filter 280ms ease;
	}

	.site-header[data-scrolled] {
		background: rgb(255 253 249 / 88%);
		box-shadow: 0 1px 0 rgb(18 59 74 / 9%);
		backdrop-filter: blur(12px);
	}

	.site-header__inner {
		position: relative;
		z-index: 2;
		display: grid;
		height: 96px;
		grid-template-columns: minmax(240px, 1fr) auto minmax(240px, 1fr);
		align-items: center;
		gap: clamp(2rem, 3vw, 4rem);
	}

	.brand {
		display: inline-flex;
		width: max-content;
		align-items: center;
		text-decoration: none;
	}

	.brand__logo {
		height: clamp(58px, 4.4vw, 68px);
		width: auto;
		max-width: min(320px, 65vw);
		object-fit: contain;
		display: block;
	}

	.desktop-navigation {
		justify-self: center;
	}

	.desktop-navigation ul {
		display: flex;
		align-items: center;
		gap: clamp(1.4rem, 2vw, 2.4rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.desktop-navigation a {
		position: relative;
		display: inline-block;
		padding-block: 0.65rem;
		font-family: var(--font-heading);
		font-size: 0.9rem;
		font-weight: 520;
		letter-spacing: -0.01em;
		text-decoration: none;
		white-space: nowrap;
	}

	.desktop-navigation a::after {
		position: absolute;
		right: 12%;
		bottom: 0.28rem;
		left: 12%;
		height: 1.5px;
		border-radius: 999px;
		background: var(--c-amber);
		content: '';
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 240ms ease;
	}

	.desktop-navigation a:hover::after,
	.desktop-navigation a[aria-current='page']::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.navbar-cta,
	.mobile-menu__cta {
		display: inline-flex;
		min-height: 52px;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-btn, 14px);
		background: var(--c-amber);
		color: var(--c-petrol);
		padding: 0.82rem 1.35rem;
		font-family: var(--font-heading);
		font-weight: 680;
		line-height: 1;
		text-decoration: none;
		transition: background-color 240ms ease, transform 240ms ease;
		white-space: nowrap;
	}

	.navbar-cta {
		justify-self: end;
	}

	.navbar-cta:hover,
	.mobile-menu__cta:hover {
		background: color-mix(in srgb, var(--c-amber) 88%, var(--c-petrol));
		transform: translateY(-2px);
	}

	.navbar-cta:focus-visible,
	.mobile-menu__cta:focus-visible,
	.menu-toggle:focus-visible {
		outline-color: var(--c-amber);
	}

	.menu-toggle,
	.mobile-menu {
		display: none;
	}

	:global(body.menu-is-open) {
		overflow: hidden;
	}

	@media (max-width: 75rem) {
		.site-header__inner {
			grid-template-columns: minmax(210px, 1fr) auto minmax(210px, 1fr);
			gap: 1.6rem;
		}

		.desktop-navigation ul {
			gap: 1.35rem;
		}
	}

	@media (max-width: 63.999rem) {
		.site-header,
		.site-header__inner {
			height: 84px;
		}

		.site-header__inner {
			grid-template-columns: 1fr auto;
			gap: 1rem;
		}

		.desktop-navigation,
		.navbar-cta {
			display: none;
		}

		.brand__logo {
			height: 54px;
		}

		.menu-toggle {
			display: inline-flex;
			position: relative;
			z-index: 2;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			width: 48px;
			height: 48px;
			border: 1px solid rgb(18 59 74 / 18%);
			border-radius: 14px;
			background: var(--c-offwhite);
			cursor: pointer;
			gap: 7px;
		}

		.menu-toggle span {
			display: block;
			width: 20px;
			height: 2px;
			border-radius: 999px;
			background: var(--c-petrol);
			transition: transform 240ms ease;
		}

		.menu-toggle[aria-expanded='true'] span:first-child {
			transform: translateY(4.5px) rotate(45deg);
		}

		.menu-toggle[aria-expanded='true'] span:last-child {
			transform: translateY(-4.5px) rotate(-45deg);
		}

		.mobile-menu:not([hidden]) {
			position: fixed;
			z-index: 1;
			top: 84px;
			right: 0;
			bottom: 0;
			left: 0;
			display: block;
			overflow-y: auto;
			border-top: 1px solid rgb(18 59 74 / 9%);
			background: var(--bg-secondary);
		}

		.mobile-menu nav {
			display: flex;
			min-height: 100%;
			flex-direction: column;
			padding-block: clamp(2.5rem, 8vh, 5rem) 2rem;
		}

		.mobile-menu ul {
			display: grid;
			gap: 0.35rem;
			margin: 0 0 2rem;
			padding: 0;
			list-style: none;
		}

		.mobile-menu li {
			opacity: 0;
			animation: mobile-link-in 360ms ease forwards;
		}

		.mobile-menu li:nth-child(2) { animation-delay: 40ms; }
		.mobile-menu li:nth-child(3) { animation-delay: 80ms; }
		.mobile-menu li:nth-child(4) { animation-delay: 120ms; }
		.mobile-menu li:nth-child(5) { animation-delay: 160ms; }

		.mobile-menu li a {
			display: flex;
			min-height: 58px;
			align-items: center;
			border-bottom: 1px solid rgb(18 59 74 / 10%);
			color: var(--c-petrol);
			font-family: var(--font-heading);
			font-size: clamp(1.55rem, 5.8vw, 2rem);
			font-weight: 560;
			letter-spacing: -0.04em;
			text-decoration: none;
		}

		.mobile-menu__cta {
			width: 100%;
			min-height: 56px;
			margin-top: auto;
		}

		.mobile-menu__meta {
			display: flex;
			flex-direction: column;
			margin-top: 1.5rem;
			color: var(--c-steel);
			font-size: 0.88rem;
			line-height: 1.5;
		}
	}

	@media (max-width: 47.999rem) {
		.brand__logo {
			height: 48px;
		}
	}

	@media (max-width: 27rem) {
		.brand__logo {
			height: 40px;
		}
	}

	@keyframes mobile-link-in {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.brand__mark,
		.brand__name,
		.brand__profession,
		.desktop-navigation a,
		.desktop-navigation a::after,
		.navbar-cta,
		.mobile-menu__cta,
		.menu-toggle span {
			transition: none;
		}

		.mobile-menu li {
			opacity: 1;
			animation: none;
		}
	}
</style>
