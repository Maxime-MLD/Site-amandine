---
import { Image } from 'astro:assets';
import portraitPlaceholder from '../assets/images/hero/portrait-placeholder.svg';
import { heroContent } from '../data/content';
---

<section class="hero site-container" id="accueil" aria-labelledby="hero-title">
	<div class="hero__panel">
		<div class="hero__intro">
			<h1 id="hero-title">
				<span>{heroContent.title.main}</span>
				<span class="hero__place">{heroContent.title.accent}</span>
			</h1>
			<p>{heroContent.subtitle}</p>
		</div>

		<div class="hero__visual">
			<div class="hero__blob" aria-hidden="true"></div>
			<div class="hero__portrait">
				<Image
					src={portraitPlaceholder}
					width={640}
					height={760}
					alt={heroContent.portrait.alt}
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			</div>
		</div>

		<div class="hero__bottom">
			<div class="hero__actions">
				<a class="hero-button hero-button--primary" href={heroContent.actions.primary.href}>
					{heroContent.actions.primary.label}
				</a>
				<a class="hero-button hero-button--secondary" href={heroContent.actions.secondary.href}>
					{heroContent.actions.secondary.label}
				</a>
			</div>

			<aside class="hero__trust-card" aria-label="Informations de confiance">
				<span class="hero__trust-dot" aria-hidden="true"></span>
				<div>
					<p class="hero__trust-title">{heroContent.trustCard.title}</p>
					<p>{heroContent.trustCard.location}</p>
					<p class="hero__trust-note">{heroContent.trustCard.note}</p>
				</div>
			</aside>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-top: 0;
	}

	.hero__panel {
		position: relative;
		display: flex;
		min-height: clamp(700px, calc(100svh - 145px), 790px);
		flex-direction: column;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--color-secondary);
		padding: clamp(2.5rem, 4.5vw, 4.5rem);
	}

	.hero__intro {
		position: relative;
		z-index: 2;
		text-align: center;
	}

	.hero__intro h1 {
		max-width: 1000px;
		margin-inline: auto;
		font-size: clamp(4rem, 5.4vw, 5.125rem);
		line-height: 0.96;
		letter-spacing: -0.055em;
	}

	.hero__intro h1 > span:first-child {
		display: block;
	}

	.hero__place {
		display: inline-block;
		color: var(--color-accent);
		font-family: var(--font-script);
		font-size: 1.2em;
		font-weight: 400;
		letter-spacing: 0;
		line-height: 0.85;
	}

	.hero__intro > p {
		max-width: 680px;
		margin: 1.35rem auto 0;
		color: var(--color-text-muted);
		font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
		line-height: 1.55;
		text-wrap: balance;
	}

	.hero__visual {
		position: relative;
		flex: 1;
		min-height: 290px;
		margin-top: 0.75rem;
	}

	.hero__blob {
		position: absolute;
		bottom: -1rem;
		left: 50%;
		width: clamp(330px, 35vw, 450px);
		height: clamp(255px, 27vw, 345px);
		border-radius: 47% 53% 43% 57% / 54% 43% 57% 46%;
		background: var(--color-background);
		transform: translateX(-50%) rotate(-1.5deg);
	}

	.hero__portrait {
		position: absolute;
		z-index: 1;
		bottom: -1rem;
		left: 50%;
		width: clamp(260px, 29vw, 370px);
		height: min(100%, 390px);
		transform: translateX(-50%);
	}

	.hero__portrait :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center bottom;
	}

	.hero__bottom {
		position: relative;
		z-index: 3;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
	}

	.hero__actions {
		display: flex;
		gap: 0.75rem;
	}

	.hero-button {
		display: inline-flex;
		min-height: 52px;
		align-items: center;
		justify-content: center;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		padding: 0.85rem 1.35rem;
		font-weight: 650;
		line-height: 1;
		text-decoration: none;
		transition: background-color 180ms ease, transform 180ms ease;
	}

	.hero-button:hover {
		transform: translateY(-2px);
	}

	.hero-button--primary {
		background: var(--color-primary);
	}

	.hero-button--primary:hover {
		background: color-mix(in srgb, var(--color-primary) 88%, var(--color-background));
	}

	.hero-button--secondary {
		border-color: var(--color-primary);
		background: var(--color-background);
	}

	.hero-button--secondary:hover {
		background: color-mix(in srgb, var(--color-background) 78%, var(--color-primary));
	}

	.hero__trust-card {
		display: grid;
		grid-template-columns: auto 1fr;
		min-width: 285px;
		align-items: start;
		gap: 1rem;
		border: 1px solid rgb(23 23 23 / 6%);
		border-radius: var(--radius-md);
		background: var(--color-background);
		box-shadow: 0 16px 40px rgb(23 23 23 / 7%);
		padding: 1.35rem 1.5rem;
	}

	.hero__trust-card p {
		font-size: 1rem;
		line-height: 1.4;
	}

	.hero__trust-card .hero__trust-title {
		font-size: 1.0625rem;
		font-weight: 700;
	}

	.hero__trust-note {
		margin-top: 0.5rem;
		color: var(--color-text-muted);
	}

	.hero__trust-dot {
		width: 12px;
		height: 12px;
		margin-top: 0.32rem;
		border-radius: 50%;
		background: var(--color-accent);
	}

	@media (max-width: 63.999rem) {
		.hero__panel {
			min-height: 700px;
			padding: clamp(2rem, 5vw, 3rem);
		}

		.hero__intro h1 {
			font-size: clamp(3.4rem, 7vw, 4.5rem);
		}

		.hero__visual {
			min-height: 280px;
		}
	}

	@media (min-width: 64rem) and (max-height: 53.125rem) {
		.hero__panel {
			min-height: 620px;
			padding-block: 2.25rem;
		}

		.hero__intro h1 {
			font-size: clamp(3.5rem, 4.8vw, 4.25rem);
		}

		.hero__intro > p {
			margin-top: 0.8rem;
			font-size: 1.0625rem;
		}

		.hero__visual {
			min-height: 210px;
			margin-top: 0.35rem;
		}

		.hero__blob {
			width: 360px;
			height: 245px;
		}

		.hero__portrait {
			width: 300px;
			height: 250px;
		}
	}

	@media (max-width: 47.999rem) {
		.hero__panel {
			min-height: auto;
			padding: 2.5rem clamp(1.25rem, 5vw, 2rem) 1.5rem;
		}

		.hero__intro h1 {
			font-size: clamp(2.65rem, 12vw, 3.65rem);
			line-height: 0.98;
		}

		.hero__intro h1 > span:first-child {
			max-width: 560px;
			margin-inline: auto;
		}

		.hero__intro > p {
			margin-top: 1.1rem;
			font-size: 1.0625rem;
		}

		.hero__visual {
			flex: none;
			min-height: 270px;
			margin-top: 1.25rem;
		}

		.hero__blob {
			bottom: 0;
			width: min(92%, 390px);
			height: 240px;
		}

		.hero__portrait {
			bottom: 0;
			width: min(76%, 300px);
			height: 270px;
		}

		.hero__bottom {
			flex-direction: column;
			align-items: stretch;
			gap: 1.5rem;
		}

		.hero__actions {
			flex-direction: column;
		}

		.hero-button {
			width: 100%;
		}

		.hero__trust-card {
			min-width: 0;
			width: 100%;
			padding: 1.25rem 1.35rem;
		}
	}

	@media (max-width: 23.5rem) {
		.hero__panel {
			border-radius: 28px;
		}

		.hero__intro h1 {
			font-size: 2.65rem;
		}
	}
</style>
