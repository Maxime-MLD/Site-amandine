---
import { Image } from 'astro:assets';
import heroPortrait from '../assets/images/cta/infirmiere.png';
import { heroContent } from '../data/content';
---

<section class="hero" id="accueil" aria-labelledby="hero-title">
	<div class="hero__panel site-container">
		<div class="hero__content">
			<p class="hero__eyebrow">
				<span aria-hidden="true"></span>
				{heroContent.eyebrow}
			</p>

			<h1 id="hero-title">
				<span class="hero__title-main">{heroContent.title.main}</span>
				<span class="hero__place">{heroContent.title.accent}</span>
			</h1>

			<p class="hero__lead">{heroContent.subtitle}</p>

			<div class="hero__actions">
				<a class="hero-button hero-button--primary" href={heroContent.actions.primary.href}>
					{heroContent.actions.primary.label}
				</a>
				<a class="hero-button hero-button--secondary" href={heroContent.actions.secondary.href}>
					{heroContent.actions.secondary.label}
				</a>
			</div>
		</div>

		<div class="hero__visual">
			<div class="hero__image-frame">
				<Image
					src={heroPortrait}
					width={1122}
					height={1402}
					sizes="(min-width: 1280px) 670px, (min-width: 768px) 48vw, calc(100vw - 32px)"
					alt={heroContent.portrait.alt}
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		background: var(--grain-image) 0 0 / 128px repeat, var(--bg-secondary);
		color: var(--c-petrol);
	}

	.hero__panel {
		display: grid;
		min-height: calc(100vh - 96px);
		min-height: calc(100svh - 96px);
		grid-template-columns: minmax(0, 0.92fr) minmax(430px, 1.08fr);
		align-items: center;
		gap: clamp(3.5rem, 6vw, 7rem);
		padding-block: clamp(2.25rem, 4.2vw, 4.75rem) clamp(3.25rem, 5.6vw, 6rem);
	}

	.hero__content {
		position: relative;
		z-index: 2;
		max-width: 690px;
		padding-left: clamp(0rem, 1vw, 1rem);
	}

	.hero__eyebrow {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		color: var(--c-steel);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.hero__eyebrow span {
		width: 2.25rem;
		height: 2px;
		background: var(--c-amber);
	}

	.hero h1 {
		max-width: 760px;
		margin-top: clamp(1.5rem, 2.2vw, 2.25rem);
		color: var(--c-petrol);
		font-size: clamp(4.25rem, 5.35vw, 6.5rem);
		font-weight: 680;
		letter-spacing: -0.065em;
		line-height: 0.88;
		text-wrap: balance;
	}

	.hero__title-main,
	.hero__place {
		display: block;
	}

	.hero__place {
		display: inline-block;
		width: fit-content;
		margin-top: -0.045em;
		color: var(--c-amber);
		background: var(--gradient-amber);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		font-family: var(--font-accent);
		font-size: 1.06em;
		font-style: italic;
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.05;
		padding-bottom: 0.25em;
		margin-bottom: -0.25em;
		padding-right: 0.08em;
	}

	.hero__lead {
		max-width: var(--intro-max-width, 38rem);
		margin-top: var(--heading-paragraph-gap, clamp(1.25rem, 0.93rem + 1.43vw, 2rem));
		color: color-mix(in srgb, var(--c-petrol) 76%, var(--c-offwhite));
		font-size: clamp(1.15rem, 1.45vw, 1.35rem);
		line-height: 1.55;
		text-wrap: balance;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		margin-top: clamp(2rem, 3vw, 3rem);
	}

	.hero-button {
		display: inline-flex;
		min-height: 54px;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--c-petrol);
		border-radius: var(--radius-btn, 14px);
		padding: 0.95rem 1.55rem;
		font-weight: 680;
		line-height: 1;
		text-decoration: none;
		transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
	}

	.hero-button:hover {
		transform: translateY(-2px);
	}

	.hero-button--primary {
		background: var(--c-petrol);
		color: var(--c-offwhite);
	}

	.hero-button--primary:hover {
		background: color-mix(in srgb, var(--c-petrol) 88%, black);
	}

	.hero-button--secondary {
		background: rgb(255 253 249 / 42%);
		color: var(--c-petrol);
	}

	.hero-button--secondary:hover {
		background: var(--c-offwhite);
	}

	.hero-button:focus-visible {
		outline-color: var(--c-amber);
	}

	.hero__visual {
		position: relative;
		align-self: stretch;
		min-height: 560px;
	}

	.hero__image-frame {
		position: absolute;
		inset: 0;
		overflow: hidden;
		border-radius: 52px 52px 52px 140px;
		background: var(--c-offwhite);
		box-shadow: 0 24px 60px rgb(18 59 74 / 10%);
	}

	.hero__image-frame :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 24%;
	}

	/* ========================================================
	   PALIERS TABLETTE (768px à 1199px)
	   ======================================================== */

	/* --- Large Tablette : 1024px – 1199px (2 colonnes équilibré, image ~420–460px) --- */
	@media (min-width: 64rem) and (max-width: 74.999rem) {
		.hero__panel {
			display: grid;
			grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
			align-items: center;
			min-height: auto;
			gap: clamp(2.5rem, 4vw, 4.5rem);
			padding-top: clamp(2rem, 3.2vw, 3rem);
			padding-bottom: clamp(2.25rem, 3.5vw, 3.25rem);
		}

		.hero__content {
			max-width: 640px;
			padding-left: 0;
		}

		.hero__eyebrow {
			font-size: 0.76rem;
			letter-spacing: 0.15em;
		}

		.hero h1 {
			margin-top: 1.25rem;
			font-size: clamp(3.5rem, 5vw, 4.6rem);
			letter-spacing: -0.06em;
			line-height: 0.88;
		}

		.hero__lead {
			margin-top: 1.35rem;
			max-width: min(44ch, 580px);
			font-size: 1.18rem;
			line-height: 1.55;
		}

		.hero__actions {
			margin-top: 1.85rem;
			display: flex;
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0.9rem;
		}

		.hero__visual {
			position: relative;
			align-self: center;
			justify-self: end;
			width: 100%;
			max-width: clamp(420px, 37vw, 460px);
			aspect-ratio: 1122 / 1402;
			min-height: 0;
			max-height: 560px;
			margin-inline: 0;
		}

		.hero__image-frame {
			border-radius: 44px 44px 44px 110px;
			box-shadow: 0 22px 55px rgb(18 59 74 / 11%);
		}
	}

	/* --- Tablette 2 : 821px – 1023px (Stack vertical iPad Air, image ~58–65%) --- */
	@media (min-width: 51.251rem) and (max-width: 63.999rem) {
		.hero__panel {
			display: flex;
			flex-direction: column;
			min-height: auto;
			gap: clamp(2rem, 3.2vw, 2.6rem);
			padding-top: clamp(1.5rem, 2.5vw, 2.15rem);
			padding-bottom: calc(0.5 * clamp(4.1rem, 5.6vw, 4.75rem) + 24px);
		}

		.hero__content {
			max-width: 680px;
			width: 100%;
			padding-left: 0;
			margin-inline: auto;
			text-align: center;
		}

		.hero__eyebrow {
			font-size: 0.76rem;
			letter-spacing: 0.15em;
			justify-content: center;
		}

		.hero h1 {
			margin-top: 1.15rem;
			font-size: clamp(3.4rem, 5.8vw, 4.25rem);
			letter-spacing: -0.055em;
			line-height: 0.9;
			max-width: 100%;
			width: 100%;
			text-align: center;
		}

		.hero__title-main {
			text-align: center;
		}

		.hero__place {
			display: inline-block;
			width: fit-content;
			margin-inline: auto;
			text-align: center;
		}

		.hero__lead {
			margin-top: 1.25rem;
			max-width: 100%;
			width: 100%;
			font-size: clamp(1.1rem, 1.35vw, 1.22rem);
			line-height: 1.55;
			margin-inline: auto;
			text-align: center;
		}

		.hero__actions {
			margin-top: 1.65rem;
			display: flex;
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0.9rem;
			justify-content: center;
		}

		.hero__visual {
			position: relative;
			align-self: center;
			width: clamp(400px, 62%, 520px);
			aspect-ratio: 1122 / 1380;
			min-height: 0;
			max-height: 520px;
			margin-inline: auto;
		}

		.hero__image-frame {
			border-radius: 38px 38px 38px 100px;
			box-shadow: 0 20px 50px rgb(18 59 74 / 12%);
		}
	}

	/* --- Tablette 1 : 768px – 820px (Stack vertical compact iPad mini, image ~65–70%) --- */
	@media (min-width: 48rem) and (max-width: 51.25rem) {
		.hero__panel {
			display: flex;
			flex-direction: column;
			min-height: auto;
			gap: 1.75rem;
			padding-top: 1.25rem;
			padding-bottom: calc(0.5 * clamp(4.1rem, 5.6vw, 4.75rem) + 24px);
		}

		.hero__content {
			max-width: 680px;
			width: 100%;
			padding-left: 0;
			margin-inline: auto;
			text-align: center;
		}

		.hero__eyebrow {
			font-size: 0.74rem;
			letter-spacing: 0.14em;
			justify-content: center;
		}

		.hero h1 {
			margin-top: 1rem;
			font-size: clamp(3rem, 7vw, 3.65rem);
			letter-spacing: -0.055em;
			line-height: 0.92;
			max-width: 100%;
			width: 100%;
			text-align: center;
		}

		.hero__title-main {
			text-align: center;
		}

		.hero__place {
			display: inline-block;
			width: fit-content;
			margin-inline: auto;
			text-align: center;
		}

		.hero__lead {
			margin-top: 1rem;
			max-width: 100%;
			width: 100%;
			font-size: 1.08rem;
			line-height: 1.5;
			margin-inline: auto;
			text-align: center;
		}

		.hero__actions {
			margin-top: 1.4rem;
			display: flex;
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0.75rem;
			justify-content: center;
		}

		.hero__visual {
			position: relative;
			align-self: center;
			width: clamp(340px, 68%, 510px);
			aspect-ratio: 1122 / 1380;
			min-height: 0;
			max-height: 480px;
			margin-inline: auto;
		}

		.hero__image-frame {
			border-radius: 38px 38px 38px 100px;
			box-shadow: 0 18px 45px rgb(18 59 74 / 12%);
		}
	}

	@media (max-width: 47.999rem) {
		.hero__panel {
			display: flex;
			min-height: auto;
			flex-direction: column;
			gap: 2.75rem;
			padding-block: 2.5rem 3rem;
		}

		.hero__content {
			max-width: 640px;
			padding-left: 0;
		}

		.hero__eyebrow {
			font-size: 0.72rem;
			letter-spacing: 0.135em;
		}

		.hero h1 {
			margin-top: 1.4rem;
			font-size: clamp(3.2rem, 14.6vw, 5rem);
			line-height: 0.89;
		}

		.hero__lead {
			margin-top: 1.45rem;
			font-size: 1.075rem;
		}

		.hero__actions {
			margin-top: 1.8rem;
		}

		.hero__visual {
			width: 100%;
			min-height: 0;
			aspect-ratio: 4 / 4.85;
		}

		.hero__image-frame {
			border-radius: 32px 32px 32px 76px;
		}
	}

	@media (max-width: 31.25rem) {
		.hero h1 {
			font-size: clamp(3rem, 14.2vw, 4.3rem);
		}

		.hero__actions {
			flex-direction: column;
		}

		.hero-button {
			width: 100%;
		}
	}

	@media (max-width: 22.5rem) {
		.hero h1 {
			font-size: 2.8rem;
		}

		.hero__eyebrow {
			gap: 0.65rem;
			font-size: 0.66rem;
		}

		.hero__eyebrow span {
			width: 1.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-button {
			transition: none;
		}
	}
</style>
