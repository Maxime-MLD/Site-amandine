---
import { Image } from 'astro:assets';
import heroPortrait from '../assets/images/cta/infirmiere.png';
import { heroContent } from '../data/content';
---

<section class="hero" id="accueil" aria-labelledby="hero-title">
	<div class="hero__panel site-container">
		<div class="hero__content">
			<p class="hero__eyebrow">
				<span aria-hidden="true"></span>
				{heroContent.eyebrow}
			</p>

			<h1 id="hero-title">
				<span class="hero__title-main">{heroContent.title.main}</span>
				<span class="hero__place">{heroContent.title.accent}</span>
			</h1>

			<p class="hero__lead">{heroContent.subtitle}</p>

			<div class="hero__actions">
				<a class="hero-button hero-button--primary" href={heroContent.actions.primary.href}>
					{heroContent.actions.primary.label}
				</a>
				<a class="hero-button hero-button--secondary" href={heroContent.actions.secondary.href}>
					{heroContent.actions.secondary.label}
				</a>
			</div>
		</div>

		<div class="hero__visual">
			<div class="hero__image-frame">
				<Image
					src={heroPortrait}
					width={1122}
					height={1402}
					sizes="(min-width: 1280px) 670px, (min-width: 768px) 48vw, calc(100vw - 32px)"
					alt={heroContent.portrait.alt}
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		background: var(--grain-image) 0 0 / 128px repeat, var(--c-ivory);
		color: var(--c-petrol);
	}

	.hero__panel {
		display: grid;
		min-height: calc(100vh - 96px);
		min-height: calc(100svh - 96px);
		grid-template-columns: minmax(0, 0.92fr) minmax(430px, 1.08fr);
		align-items: center;
		gap: clamp(3.5rem, 6vw, 7rem);
		padding-block: clamp(2.25rem, 4.2vw, 4.75rem) clamp(3.25rem, 5.6vw, 6rem);
	}

	.hero__content {
		position: relative;
		z-index: 2;
		max-width: 690px;
		padding-left: clamp(0rem, 1vw, 1rem);
	}

	.hero__eyebrow {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		color: var(--c-steel);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.hero__eyebrow span {
		width: 2.25rem;
		height: 2px;
		background: var(--c-amber);
	}

	.hero h1 {
		max-width: 760px;
		margin-top: clamp(1.5rem, 2.2vw, 2.25rem);
		color: var(--c-petrol);
		font-size: clamp(4.25rem, 5.35vw, 6.5rem);
		font-weight: 680;
		letter-spacing: -0.065em;
		line-height: 0.88;
		text-wrap: balance;
	}

	.hero__title-main,
	.hero__place {
		display: block;
	}

	.hero__place {
		width: fit-content;
		margin-top: -0.045em;
		color: var(--c-amber);
		font-family: var(--font-accent);
		font-size: 1.06em;
		font-style: italic;
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 0.88;
	}

	.hero__lead {
		max-width: 600px;
		margin-top: clamp(1.6rem, 2.4vw, 2.4rem);
		color: color-mix(in srgb, var(--c-petrol) 76%, var(--c-offwhite));
		font-size: clamp(1.15rem, 1.45vw, 1.35rem);
		line-height: 1.55;
		text-wrap: balance;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		margin-top: clamp(2rem, 3vw, 3rem);
	}

	.hero-button {
		display: inline-flex;
		min-height: 56px;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--c-petrol);
		border-radius: 14px;
		padding: 0.95rem 1.55rem;
		font-weight: 680;
		line-height: 1;
		text-decoration: none;
		transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
	}

	.hero-button:hover {
		transform: translateY(-2px);
	}

	.hero-button--primary {
		background: var(--c-petrol);
		color: var(--c-offwhite);
	}

	.hero-button--primary:hover {
		background: color-mix(in srgb, var(--c-petrol) 88%, black);
	}

	.hero-button--secondary {
		background: rgb(255 253 249 / 42%);
		color: var(--c-petrol);
	}

	.hero-button--secondary:hover {
		background: var(--c-offwhite);
	}

	.hero-button:focus-visible {
		outline-color: var(--c-amber);
	}

	.hero__visual {
		position: relative;
		align-self: stretch;
		min-height: 560px;
	}

	.hero__image-frame {
		position: absolute;
		inset: 0;
		overflow: hidden;
		border-radius: 52px 52px 52px 140px;
		background: var(--c-offwhite);
		box-shadow: 0 24px 60px rgb(18 59 74 / 10%);
	}

	.hero__image-frame :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 24%;
	}

	@media (max-width: 75rem) {
		.hero__panel {
			min-height: calc(100vh - 96px);
			min-height: calc(100svh - 96px);
			grid-template-columns: minmax(0, 0.98fr) minmax(390px, 1.02fr);
			gap: clamp(2.5rem, 4.2vw, 4.5rem);
		}

		.hero h1 {
			font-size: clamp(3.75rem, 5.8vw, 5.25rem);
		}

		.hero__visual {
			min-height: 525px;
		}
	}

	@media (max-width: 63.999rem) {
		.hero__panel {
			min-height: calc(100vh - 84px);
			min-height: calc(100svh - 84px);
			grid-template-columns: minmax(0, 1fr) minmax(330px, 0.9fr);
			gap: 2.5rem;
			padding-block: 2.5rem 4rem;
		}

		.hero h1 {
			font-size: clamp(3.35rem, 6.8vw, 4.5rem);
		}

		.hero__lead {
			font-size: 1.1rem;
		}

		.hero__visual {
			min-height: 480px;
		}

		.hero__image-frame {
			border-radius: 38px 38px 38px 100px;
		}
	}

	@media (max-width: 47.999rem) {
		.hero__panel {
			display: flex;
			min-height: auto;
			flex-direction: column;
			gap: 2.75rem;
			padding-block: 2.5rem 3rem;
		}

		.hero__content {
			max-width: 640px;
			padding-left: 0;
		}

		.hero__eyebrow {
			font-size: 0.72rem;
			letter-spacing: 0.135em;
		}

		.hero h1 {
			margin-top: 1.4rem;
			font-size: clamp(3.2rem, 14.6vw, 5rem);
			line-height: 0.89;
		}

		.hero__lead {
			margin-top: 1.45rem;
			font-size: 1.075rem;
		}

		.hero__actions {
			margin-top: 1.8rem;
		}

		.hero__visual {
			width: 100%;
			min-height: 0;
			aspect-ratio: 4 / 4.85;
		}

		.hero__image-frame {
			border-radius: 32px 32px 32px 76px;
		}
	}

	@media (max-width: 31.25rem) {
		.hero h1 {
			font-size: clamp(3rem, 14.2vw, 4.3rem);
		}

		.hero__actions {
			flex-direction: column;
		}

		.hero-button {
			width: 100%;
		}
	}

	@media (max-width: 22.5rem) {
		.hero h1 {
			font-size: 2.8rem;
		}

		.hero__eyebrow {
			gap: 0.65rem;
			font-size: 0.66rem;
		}

		.hero__eyebrow span {
			width: 1.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-button {
			transition: none;
		}
	}
</style>
