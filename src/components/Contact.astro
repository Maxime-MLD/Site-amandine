---
import { Image } from 'astro:assets';
import cabinetPhoto from '../assets/images/contact/cabinet-consultation.jpg';
import { siteConfig } from '../config/site';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
const hasPhone = Boolean(siteConfig.phone && !siteConfig.phone.startsWith('TODO_'));
const hasEmail = Boolean(siteConfig.email && !siteConfig.email.startsWith('TODO_'));
const phoneHref = hasPhone ? `tel:${siteConfig.phone.replace(/[\s.-]/g, '')}` : '#';
const emailHref = hasEmail ? `mailto:${siteConfig.email}` : '#';
---

<section class="contact" id="contact" aria-labelledby="contact-title" data-contact>
	<div class="site-container">
		<!-- Section Header (Le bloc texte) -->
		<header class="contact__header">
			<p class="contact__eyebrow">Contact</p>
			<h2 id="contact-title" class="contact__title">
				Parlons de votre prochain <span class="contact__title-accent">soin</span>.
			</h2>
			<p class="contact__lead">
				Une question ou besoin d’organiser un rendez-vous ? Contactez-moi pour convenir de votre prise en charge.
			</p>
		</header>

		<div class="contact__grid">
			<!-- Left Column: Le bloc image & coordonnées -->
			<div class="contact__left">

				<!-- 16/9 Cabinet Consultation Photo -->
				<div class="contact__visual">
					<Image
						src={cabinetPhoto}
						width={1280}
						height={720}
						alt="Bureau et espace de consultation du cabinet infirmier, propre, chaleureux et lumineux"
						loading="lazy"
						decoding="async"
						class="contact__visual-img"
					/>
				</div>

				<!-- Practical Information / Coordinates (Clean lines with subtle dividers) -->
				<dl class="contact__details">
					<div class="contact__detail-item">
						<dt>Téléphone</dt>
						<dd>
							{hasPhone ? (
								<a href={phoneHref} class="contact__link">{siteConfig.phone}</a>
							) : (
								<span class="contact__placeholder">[Numéro à compléter]</span>
							)}
						</dd>
					</div>

					<div class="contact__detail-item">
						<dt>Email</dt>
						<dd>
							{hasEmail ? (
								<a href={emailHref} class="contact__link">{siteConfig.email}</a>
							) : (
								<span class="contact__placeholder">[Email à compléter]</span>
							)}
						</dd>
					</div>

					<div class="contact__detail-item">
						<dt>Secteur</dt>
						<dd>Montagny et environ 10 km</dd>
					</div>

					<div class="contact__detail-item">
						<dt>Cabinet</dt>
						<dd>Uniquement sur rendez-vous</dd>
					</div>

					<div class="contact__detail-item contact__detail-item--wide">
						<dt>Disponibilité</dt>
						<dd>24h/24 · 7j/7 selon l’organisation de la prise en charge</dd>
					</div>
				</dl>
			</div>

			<!-- Right Column: Premium Ivory Form Card -->
			<div class="contact__right">
				<div class="contact-form-card" data-contact-form-card>
					<form
						class="contact-form"
						action="https://api.web3forms.com/submit"
						method="POST"
						novalidate
						data-contact-form
					>
						<!-- Web3Forms Hidden Settings -->
						<input type="hidden" name="access_key" value={accessKey} />
						<input type="hidden" name="subject" value="Nouvelle demande de rendez-vous - Site d’Amandine Gauthier" />
						<input type="hidden" name="from_name" value="Site d’Amandine Gauthier" />
						<div class="contact-form__honeypot" aria-hidden="true">
							<label for="contact-botcheck">Ne pas remplir ce champ</label>
							<input id="contact-botcheck" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
						</div>

						<div class="contact-form__fields">
							<!-- Nom et prénom * -->
							<div class="form-field">
								<label for="contact-name">
									Nom et prénom <span class="form-field__required" aria-hidden="true">*</span>
								</label>
								<input
									id="contact-name"
									type="text"
									name="name"
									placeholder="Votre nom et prénom"
									autocomplete="name"
									required
									data-contact-field
								/>
								<p class="form-field__error" id="contact-name-error" hidden data-contact-error></p>
							</div>

							<!-- Téléphone * -->
							<div class="form-field">
								<label for="contact-phone">
									Téléphone <span class="form-field__required" aria-hidden="true">*</span>
								</label>
								<input
									id="contact-phone"
									type="tel"
									name="phone"
									placeholder="06 00 00 00 00"
									autocomplete="tel"
									inputmode="tel"
									required
									data-contact-field
								/>
								<p class="form-field__error" id="contact-phone-error" hidden data-contact-error></p>
							</div>

							<!-- Email (Optionnel) -->
							<div class="form-field">
								<label for="contact-email">
									Email <span class="form-field__optional">(optionnel)</span>
								</label>
								<input
									id="contact-email"
									type="email"
									name="email"
									placeholder="nom@exemple.fr"
									autocomplete="email"
									data-contact-field
								/>
								<p class="form-field__error" id="contact-email-error" hidden data-contact-error></p>
							</div>

							<!-- Lieu du soin * -->
							<div class="form-field">
								<label for="contact-location">
									Lieu du soin <span class="form-field__required" aria-hidden="true">*</span>
								</label>
								<div class="form-field__select-wrap">
									<select id="contact-location" name="care_location" required data-contact-field>
										<option value="">Sélectionnez le lieu du soin</option>
										<option value="À domicile">À domicile</option>
										<option value="Au cabinet">Au cabinet</option>
										<option value="Je ne sais pas encore">Je ne sais pas encore</option>
									</select>
									<svg class="form-field__chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
										<path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
									</svg>
								</div>
								<p class="form-field__error" id="contact-location-error" hidden data-contact-error></p>
							</div>

							<!-- Message * -->
							<div class="form-field form-field--wide">
								<label for="contact-message">
									Message <span class="form-field__required" aria-hidden="true">*</span>
								</label>
								<textarea
									id="contact-message"
									name="message"
									rows="6"
									placeholder="Indiquez simplement votre besoin de rendez-vous ou votre demande de contact."
									required
									data-contact-field
								></textarea>
								<p class="form-field__confidentiality">
									Pour protéger votre confidentialité, évitez de transmettre des informations médicales sensibles dans ce formulaire.
								</p>
								<p class="form-field__error" id="contact-message-error" hidden data-contact-error></p>
							</div>
						</div>

						<!-- Form Footer: Submit Button & Status Alerts -->
						<div class="contact-form__footer">
							<button class="contact-form__submit" type="submit" data-contact-submit>
								<span class="contact-form__spinner" aria-hidden="true" data-contact-spinner></span>
								<span data-contact-submit-label>Envoyer ma demande</span>
								<svg class="contact-form__btn-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
									<path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
								</svg>
							</button>
						</div>

						<!-- Status Message Inline Container -->
						<div
							class="contact-form__status"
							tabindex="-1"
							aria-live="polite"
							hidden
							data-contact-status
						></div>
					</form>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.contact {
		position: relative;
		overflow: clip;
		background-color: #fffdf9;
		background-image: var(--grain-image);
		background-size: 128px;
		background-repeat: repeat;
		padding-block: clamp(5rem, 8vw, 7.5rem);
	}

	/* Header Block (Le bloc texte) */
	.contact__header {
		margin-bottom: clamp(2.5rem, 4vw, 3.85rem);
		max-width: 48rem;
	}

	.contact__eyebrow {
		margin-bottom: 0.85rem;
		color: #d99a3e;
		font-family: var(--font-heading);
		font-size: var(--text-small);
		font-weight: 750;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.contact__title {
		color: #123b4a;
		font-family: var(--font-heading);
		font-size: clamp(2.35rem, 4vw, 3.45rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1.14;
		margin: 0;
	}

	.contact__title-accent {
		display: inline-block;
		color: #d99a3e;
		font-family: var(--font-accent);
		font-style: italic;
		font-weight: 600;
		letter-spacing: -0.02em;
		text-decoration: none;
		border: none;
		margin-left: 0.04em;
	}

	.contact__lead {
		margin-top: clamp(1rem, 1.8vw, 1.45rem);
		color: #52798a;
		font-family: var(--font-heading);
		font-size: clamp(1.025rem, 1.25vw, 1.15rem);
		line-height: 1.6;
		max-width: 38rem;
	}

	/* Main 2-Column Grid: Visual Block & Form Card côte à côte */
	.contact__grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		gap: clamp(2.5rem, 4.5vw, 4.5rem);
		align-items: stretch;
	}

	/* Left Column: Le bloc image + coordonnées */
	.contact__left {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		height: 100%;
		gap: clamp(1.5rem, 2.5vw, 2.25rem);
	}

	/* 16/9 Cabinet Photo (starts flush with form card top) */
	.contact__visual {
		position: relative;
		margin-top: 0;
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: clamp(1.15rem, 1.8vw, 1.45rem);
		overflow: hidden;
		border: 1px solid rgba(18, 59, 74, 0.09);
		box-shadow: 0 10px 30px rgba(18, 59, 74, 0.06);
		background-color: #f4efe7;
	}

	.contact__visual-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
	}

	/* Practical Details / Coordinates (2-column compact grid on desktop) */
	.contact__details {
		margin-top: clamp(1.4rem, 2.2vw, 1.85rem);
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: clamp(1.25rem, 2.2vw, 2.25rem);
		border-top: 1px solid rgba(18, 59, 74, 0.12);
	}

	.contact__detail-item {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding-block: 0.8rem;
		border-bottom: 1px solid rgba(18, 59, 74, 0.12);
	}

	.contact__detail-item--wide {
		grid-column: 1 / -1;
	}

	.contact__detail-item:first-child {
		border-top: none;
	}

	.contact__detail-item dt {
		color: #52798a;
		font-family: var(--font-heading);
		font-size: 0.76rem;
		font-weight: 750;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.contact__detail-item dd {
		margin: 0;
		color: #123b4a;
		font-family: var(--font-heading);
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.contact__link {
		color: #123b4a;
		text-decoration: none;
		transition: color 180ms ease;
	}

	.contact__link:hover {
		color: #d99a3e;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.contact__placeholder {
		color: rgba(18, 59, 74, 0.55);
		font-style: italic;
		font-weight: 500;
	}

	/* Right Column: Form Card */
	.contact__right {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.contact-form-card {
		position: relative;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		border-radius: clamp(1.6rem, 2.6vw, 2.35rem);
		background: linear-gradient(145deg, #f8f4ee 0%, #f4efe7 46%, #ede6da 100%);
		border: 1px solid rgba(18, 59, 74, 0.08);
		box-shadow:
			0 18px 44px rgba(18, 59, 74, 0.05),
			0 4px 14px rgba(18, 59, 74, 0.03);
		padding: clamp(2.4rem, 4vw, 3.75rem);
		overflow: hidden;
	}

	/* Ultra-subtle paper grain on form card */
	.contact-form-card::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background-image: var(--grain-image);
		background-size: 128px;
		background-repeat: repeat;
		opacity: 0.028;
		pointer-events: none;
	}

	.contact-form {
		position: relative;
		z-index: 1;
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.contact-form__honeypot {
		position: absolute !important;
		width: 1px !important;
		height: 1px !important;
		overflow: hidden !important;
		clip: rect(0 0 0 0) !important;
		clip-path: inset(50%) !important;
		white-space: nowrap !important;
	}

	.contact-form__fields {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.6rem 1.35rem;
	}

	.form-field {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.form-field--wide {
		grid-column: 1 / -1;
	}

	.form-field label {
		margin-bottom: 0.55rem;
		color: #123b4a;
		font-family: var(--font-heading);
		font-size: 0.94rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.form-field__required {
		color: #d99a3e;
		font-weight: 800;
		margin-left: 0.15rem;
	}

	.form-field__optional {
		color: #52798a;
		font-size: 0.82rem;
		font-weight: 500;
		margin-left: 0.35rem;
	}

	.form-field input,
	.form-field select,
	.form-field textarea {
		width: 100%;
		background-color: #fffdf9;
		color: #123b4a;
		border: 1px solid rgba(18, 59, 74, 0.16);
		border-radius: 0.8rem;
		font-family: var(--font-heading);
		font-size: 0.98rem;
		line-height: 1.4;
		outline: none;
		transition:
			border-color 180ms ease,
			box-shadow 180ms ease,
			background-color 180ms ease;
	}

	.form-field input,
	.form-field select {
		min-height: 3.6rem;
		padding: 0.85rem 1.15rem;
	}

	.form-field textarea {
		min-height: 10.5rem;
		resize: vertical;
		padding: 1rem 1.15rem;
		line-height: 1.6;
	}

	.form-field input::placeholder,
	.form-field textarea::placeholder {
		color: rgba(82, 121, 138, 0.62);
	}

	.form-field input:focus,
	.form-field select:focus,
	.form-field textarea:focus {
		border-color: #d99a3e;
		box-shadow: 0 0 0 3px rgba(217, 154, 62, 0.18);
		background-color: #ffffff;
	}

	.form-field input[aria-invalid='true'],
	.form-field select[aria-invalid='true'],
	.form-field textarea[aria-invalid='true'] {
		border-color: #c94a5e;
		box-shadow: 0 0 0 3px rgba(201, 74, 94, 0.12);
	}

	/* Custom Select with Chevron */
	.form-field__select-wrap {
		position: relative;
		display: flex;
		align-items: center;
	}

	.form-field__select-wrap select {
		appearance: none;
		-webkit-appearance: none;
		padding-right: 2.75rem;
		cursor: pointer;
	}

	.form-field__chevron {
		position: absolute;
		right: 1.15rem;
		width: 1rem;
		height: 1rem;
		color: #52798a;
		pointer-events: none;
		transition: transform 180ms ease;
	}

	.form-field__confidentiality {
		margin-top: 0.6rem;
		color: #52798a;
		font-family: var(--font-heading);
		font-size: 0.83rem;
		line-height: 1.45;
	}

	.form-field__error {
		margin-top: 0.45rem;
		color: #c94a5e;
		font-family: var(--font-heading);
		font-size: 0.84rem;
		font-weight: 600;
		line-height: 1.35;
	}

	/* Submit Button & Footer */
	.contact-form__footer {
		margin-top: clamp(2rem, 2.8vw, 2.65rem);
		display: flex;
		align-items: center;
	}

	.contact-form__submit {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		background-color: #123b4a;
		color: #fffdf9;
		border: 1px solid transparent;
		border-radius: 16px;
		padding: 1.05rem 2.35rem;
		font-family: var(--font-heading);
		font-size: 1rem;
		font-weight: 750;
		cursor: pointer;
		transition:
			background-color 200ms ease,
			transform 200ms ease,
			box-shadow 200ms ease,
			opacity 200ms ease;
		box-shadow: 0 4px 14px rgba(18, 59, 74, 0.16);
	}

	.contact-form__submit:hover:not(:disabled) {
		background-color: #184b5c;
		transform: translateY(-2px);
		box-shadow: 0 6px 18px rgba(18, 59, 74, 0.22);
	}

	.contact-form__submit:focus-visible {
		outline: 2px solid #d99a3e;
		outline-offset: 3px;
	}

	.contact-form__submit:disabled {
		cursor: wait;
		opacity: 0.75;
	}

	.contact-form__btn-arrow {
		width: 1rem;
		height: 1rem;
		transition: transform 200ms ease;
	}

	.contact-form__submit:hover:not(:disabled) .contact-form__btn-arrow {
		transform: translateX(4px);
	}

	.contact-form__spinner {
		display: none;
		width: 1rem;
		height: 1rem;
		border: 2px solid rgba(255, 253, 249, 0.28);
		border-top-color: #fffdf9;
		border-radius: 50%;
		animation: contact-spin 700ms linear infinite;
	}

	.contact-form__spinner.is-visible {
		display: block;
	}

	@keyframes contact-spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* Status Message Inline Container */
	.contact-form__status {
		margin-top: 1.35rem;
		border-radius: 0.85rem;
		padding: 0.95rem 1.15rem;
		font-family: var(--font-heading);
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.45;
	}

	.contact-form__status[data-status='success'] {
		background-color: rgba(46, 125, 90, 0.12);
		border: 1px solid rgba(46, 125, 90, 0.25);
		color: #1b533a;
	}

	.contact-form__status[data-status='error'] {
		background-color: rgba(201, 74, 94, 0.1);
		border: 1px solid rgba(201, 74, 94, 0.25);
		color: #922838;
	}

	/* Responsive Tablet */
	@media (max-width: 63.999rem) {
		.contact__grid {
			grid-template-columns: 1fr;
			gap: 3.5rem;
		}

		.contact-form-card {
			padding: clamp(1.75rem, 4vw, 2.5rem);
		}
	}

	/* Responsive Mobile */
	@media (max-width: 47.999rem) {
		.contact {
			padding-block: 3.75rem;
		}

		.contact__header {
			margin-bottom: 2.25rem;
		}

		.contact__grid {
			display: flex;
			flex-direction: column;
			gap: 2.5rem;
		}

		.contact__left {
			height: auto;
			gap: 1.5rem;
		}

		.contact__visual {
			border-radius: 1rem;
		}

		.contact__details {
			grid-template-columns: 1fr;
		}

		.contact__detail-item--wide {
			grid-column: auto;
		}

		.contact__right {
			height: auto;
			width: 100%;
		}

		.contact-form-card {
			height: auto;
			border-radius: 1.35rem;
			padding: 2rem 1.35rem;
		}

		.contact-form {
			height: auto;
		}

		.contact-form__fields {
			grid-template-columns: 1fr;
			gap: 1.35rem;
		}

		.contact-form__submit {
			width: 100%;
			padding-block: 1.05rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-form__submit,
		.contact-form__btn-arrow {
			transition: none !important;
		}

		.contact-form__spinner {
			animation: none !important;
		}
	}
</style>
