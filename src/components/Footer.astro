---
import { Image } from 'astro:assets';
import logoAmandineFooter from '../assets/images/logo-amandine-footer.png';
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
const hasPhone = Boolean(siteConfig.phone && !siteConfig.phone.startsWith('TODO_'));
const hasEmail = Boolean(siteConfig.email && !siteConfig.email.startsWith('TODO_'));
const phoneHref = hasPhone ? `tel:${siteConfig.phone.replace(/[\s.-]/g, '')}` : '#';
const emailHref = hasEmail ? `mailto:${siteConfig.email}` : '#';

const footerNavigation = [
	{ label: 'Accueil', href: '/#accueil' },
	{ label: 'Soins', href: '/#soins' },
	{ label: 'À propos', href: '/#a-propos' },
	{ label: 'Pour qui ?', href: '/#pour-qui' },
	{ label: 'Prise en charge', href: '/#prise-en-charge' },
	{ label: 'FAQ', href: '/#faq' },
	{ label: 'Contact', href: '/#contact' },
] as const;
---

<footer class="site-footer">
	<!-- Monumental Background Cardiogram (Design Statement) -->
	<div class="site-footer__ecg-bg" aria-hidden="true">
		<svg class="site-footer__monumental-ecg" viewBox="0 0 1600 400" fill="none" preserveAspectRatio="none">
			<defs>
				<linearGradient id="monumentalEcgGrad" x1="0%" y1="0%" x2="100%" y2="0%">
					<stop offset="0%" stop-color="#52798a" stop-opacity="0" />
					<stop offset="8%" stop-color="#52798a" stop-opacity="0.35" />
					<stop offset="18%" stop-color="#52798a" stop-opacity="0.85" />
					<stop offset="32%" stop-color="#2c697e" stop-opacity="0.95" />
					<stop offset="50%" stop-color="#f4efe7" stop-opacity="0.9" />
					<stop offset="68%" stop-color="#1b4f62" stop-opacity="0.95" />
					<stop offset="82%" stop-color="#52798a" stop-opacity="0.85" />
					<stop offset="92%" stop-color="#52798a" stop-opacity="0.35" />
					<stop offset="100%" stop-color="#52798a" stop-opacity="0" />
				</linearGradient>
			</defs>
			<path
				class="footer-monumental-ecg__path"
				d="M 0 240 L 720 240 L 740 40 L 760 360 L 780 150 L 800 290 L 815 240 L 925 240 L 945 80 L 965 330 L 980 240 L 1600 240"
				stroke="url(#monumentalEcgGrad)"
				stroke-width="28"
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
		</svg>
	</div>

	<div class="site-footer__inner site-container">
		<div class="site-footer__main">
			<!-- Identity / Brand Column -->
			<div class="site-footer__identity">
				<a class="site-footer__brand" href="/#accueil" aria-label={`${siteConfig.fullName}, retour à l’accueil`}>
					<Image
						class="site-footer__brand-logo"
						src={logoAmandineFooter}
						alt={`${siteConfig.fullName} — Infirmière à domicile`}
						width={250}
						loading="lazy"
						decoding="async"
					/>
				</a>
				<p class="site-footer__place">Montagny et alentours</p>
				<p class="site-footer__promise">
					Soins infirmiers à domicile avec écoute, disponibilité et professionnalisme.
				</p>
				<div class="site-footer__availability">
					<p class="site-footer__heading">Disponibilités</p>
					<p class="site-footer__availability-time">24h/24 · 7j/7</p>
					<p class="site-footer__availability-sub">
						Continuité des soins selon prescription et organisation de la prise en charge.
					</p>
				</div>
			</div>

			<!-- Navigation Column -->
			<nav class="site-footer__navigation" aria-label="Navigation du pied de page">
				<p class="site-footer__heading">Navigation</p>
				<ul>
					{footerNavigation.map((item) => (
						<li><a href={item.href}>{item.label}</a></li>
					))}
				</ul>
			</nav>

			<!-- Contact Column -->
			<div class="site-footer__contact">
				<p class="site-footer__heading">Contact</p>
				<dl>
					<div class="site-footer__phone">
						<dt>Téléphone</dt>
						<dd>{hasPhone ? <a href={phoneHref}>{siteConfig.phone}</a> : 'À compléter'}</dd>
					</div>
					<div>
						<dt>Email</dt>
						<dd>{hasEmail ? <a href={emailHref}>{siteConfig.email}</a> : 'À compléter'}</dd>
					</div>
					<div>
						<dt>Secteur</dt>
						<dd>Montagny et alentours</dd>
					</div>
					<div>
						<dt>Cabinet</dt>
						<dd>39, rue de la République<br />42840 Montagny</dd>
					</div>
				</dl>
			</div>
		</div>

		<!-- Bottom Copyright & Legal Links -->
		<div class="site-footer__bottom">
			<p class="site-footer__copyright">© {currentYear} {siteConfig.fullName} — Tous droits réservés.</p>
			<div class="site-footer__bottom-links">
				<p class="site-footer__credit">
					Site réalisé par
					<a class="site-footer__credit-link" href="https://www.mld-studio.fr" target="_blank" rel="noopener noreferrer">MLD.studio</a>
				</p>
				<nav class="site-footer__legal-nav" aria-label="Informations légales">
					<a href="/mentions-legales/">Mentions légales</a>
					<a href="/politique-de-confidentialite/">Politique de confidentialité</a>
				</nav>
			</div>
		</div>
	</div>
</footer>

<script>
	function initFooterEcg() {
		const path = document.querySelector<SVGPathElement>('.footer-monumental-ecg__path');
		const footer = document.querySelector<HTMLElement>('.site-footer');
		if (!path || !footer) return;

		// Calculate exact SVG path length
		const length = Math.ceil(path.getTotalLength()) || 2200;
		path.style.strokeDasharray = `${length}`;

		// Instant full line without animation on mobile or reduced motion
		const isMobile = window.matchMedia('(max-width: 47.999rem)').matches;
		if (isMobile || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			path.style.strokeDashoffset = '0';
			path.style.strokeDasharray = 'none';
			path.style.transition = 'none';
			return;
		}

		// Initial state: hidden
		path.style.strokeDashoffset = `${length}`;

		// IntersectionObserver to animate once on entry
		const observer = new IntersectionObserver(
			(entries) => {
				const entry = entries[0];
				if (entry.isIntersecting) {
					requestAnimationFrame(() => {
						path.style.transition = 'stroke-dashoffset 3.8s cubic-bezier(0.22, 0.85, 0.36, 1)';
						path.style.strokeDashoffset = '0';
					});
					observer.disconnect();
				}
			},
			{ threshold: 0.1 }
		);

		observer.observe(footer);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initFooterEcg);
	} else {
		initFooterEcg();
	}
</script>

<style>
	.site-footer {
		position: relative;
		overflow: hidden;
		background: var(--bg-dark);
		color: var(--c-ivory);
	}

	/* Ultra-subtle paper grain */
	.site-footer::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image: var(--grain-image);
		background-size: 128px;
		background-repeat: repeat;
		opacity: 0.028;
		pointer-events: none;
		z-index: 0;
	}

	.site-footer__inner {
		position: relative;
		z-index: 1;
	}

	/* 3-column balanced grid with ~20% reduced vertical padding */
	.site-footer__main {
		display: grid;
		grid-template-columns: 1.3fr 0.8fr 1fr;
		align-items: start;
		gap: clamp(3rem, 5.5vw, 6rem);
		padding-block: clamp(4.25rem, 5.5vw, 6.25rem) clamp(2.75rem, 3.5vw, 4rem);
	}

	/* Identity / Brand Column */
	.site-footer__identity {
		max-width: 29rem;
	}

	.site-footer__brand,
	.site-footer__brand:hover {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		opacity: 1;
		transform: none;
	}

	/* Logo sizing: calibrated between 240px and 260px on desktop */
	.site-footer__brand-logo {
		width: clamp(235px, 17vw, 260px);
		height: auto;
		max-width: 100%;
		object-fit: contain;
		display: block;
	}

	/* Location text with amber dot */
	.site-footer__place {
		display: flex;
		align-items: center;
		margin-top: 1.85rem;
		color: var(--c-ivory);
		font-family: var(--font-heading);
		font-size: 0.98rem;
		font-weight: 650;
		letter-spacing: -0.01em;
	}

	.site-footer__place::before {
		display: inline-block;
		width: 0.45rem;
		height: 0.45rem;
		margin-right: 0.6rem;
		border-radius: 50%;
		background: var(--c-amber);
		content: '';
		flex-shrink: 0;
	}

	/* Description promise */
	.site-footer__promise {
		max-width: 33ch;
		margin-top: 1.15rem;
		color: rgba(244, 239, 231, 0.76);
		font-size: 0.96rem;
		font-weight: 400;
		line-height: 1.65;
	}

	/* Availability: harmonized with 24h/24 · 7j/7 */
	.site-footer__availability {
		margin-top: 2rem;
	}

	.site-footer__availability-time {
		margin: 0.45rem 0 0;
		color: var(--c-ivory);
		font-size: 1.15rem;
		font-weight: 650;
		line-height: 1.35;
	}

	.site-footer__availability-sub {
		margin: 0.35rem 0 0;
		color: rgba(244, 239, 231, 0.68);
		font-size: 0.85rem;
		font-weight: 450;
		line-height: 1.45;
		max-width: 32ch;
	}

	/* Uniform amber headings */
	.site-footer__heading,
	.site-footer dt {
		margin: 0;
		color: var(--c-amber);
		font-family: var(--font-heading);
		font-size: 0.75rem;
		font-weight: 750;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	/* Navigation Column */
	.site-footer__navigation ul {
		display: grid;
		gap: 0.85rem;
		margin: 1.45rem 0 0;
		padding: 0;
		list-style: none;
	}

	.site-footer a:not(.site-footer__brand) {
		color: rgba(244, 239, 231, 0.88);
		text-decoration: none;
		font-size: 0.96rem;
		line-height: 1.4;
		transition: color 200ms ease;
	}

	.site-footer a:not(.site-footer__brand):hover {
		color: var(--c-amber);
	}

	.site-footer a:not(.site-footer__brand):focus-visible {
		outline: 2px solid var(--c-amber);
		outline-offset: 3px;
		border-radius: 2px;
	}

	/* Contact Column */
	.site-footer__contact dl {
		display: grid;
		gap: 1.35rem;
		margin: 1.45rem 0 0;
	}

	.site-footer dd {
		margin: 0.35rem 0 0;
		color: rgba(244, 239, 231, 0.92);
		font-size: 0.98rem;
		font-weight: 550;
		line-height: 1.45;
		overflow-wrap: anywhere;
	}

	.site-footer__phone dd {
		font-family: var(--font-heading);
		font-size: clamp(1.2rem, 1.45vw, 1.4rem);
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.site-footer__phone a {
		color: var(--c-ivory) !important;
		text-decoration: none;
		transition: color 200ms ease;
	}

	.site-footer__phone a:hover {
		color: var(--c-amber) !important;
	}

	/* Monumental Background Cardiogram: subtle, lower, opacity 0.075 */
	.site-footer__ecg-bg {
		position: absolute;
		inset-inline: 0;
		top: 54%;
		transform: translateY(-50%) translateX(2%);
		height: clamp(22rem, 42vw, 32rem);
		pointer-events: none;
		z-index: 0;
		-webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.3) 6%, black 16%, black 84%, rgba(0, 0, 0, 0.3) 94%, transparent 100%);
		mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.3) 6%, black 16%, black 84%, rgba(0, 0, 0, 0.3) 94%, transparent 100%);
	}

	.site-footer__monumental-ecg {
		width: 100%;
		height: 100%;
		display: block;
		overflow: visible;
	}

	.footer-monumental-ecg__path {
		opacity: 0.075;
	}

	/* Bottom Bar & Subtle Separator */
	.site-footer__bottom {
		border-top: 1px solid rgba(244, 239, 231, 0.08);
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1.25rem 2.5rem;
		padding-block: clamp(1.5rem, 2vw, 2.25rem) clamp(1.75rem, 2.5vw, 2.5rem);
		color: rgba(244, 239, 231, 0.65);
		font-size: 0.875rem;
		line-height: 1.45;
	}

	.site-footer__copyright {
		margin: 0;
	}

	.site-footer__bottom-links {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		flex-wrap: wrap;
	}

	.site-footer__credit {
		margin: 0;
	}

	.site-footer__credit-link {
		margin-left: 0.25rem;
		color: rgba(244, 239, 231, 0.9);
		font-weight: 700;
	}

	.site-footer__legal-nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	/* Tablet responsive */
	@media (max-width: 63.999rem) {
		.site-footer__main {
			grid-template-columns: 1fr 1fr;
			gap: 3.5rem 4rem;
			padding-block: clamp(3.75rem, 6.5vw, 5.25rem) clamp(2.5rem, 4vw, 3.25rem);
		}

		.site-footer__identity {
			grid-column: 1 / -1;
			max-width: 32rem;
		}

		.site-footer__brand-logo {
			width: clamp(210px, 26vw, 240px);
		}

		.site-footer__bottom {
			flex-direction: column;
			align-items: flex-start;
			gap: 1.25rem;
		}

		.site-footer__bottom-links {
			width: 100%;
			justify-content: space-between;
		}
	}

	/* Mobile responsive: clean vertical stack in recommended order */
	@media (max-width: 47.999rem) {
		.site-footer__main {
			display: flex;
			flex-direction: column;
			gap: 0;
			padding-block: clamp(3.25rem, 8.5vw, 4.5rem) clamp(2.25rem, 5vw, 3rem);
		}

		.site-footer__identity {
			order: 1;
			max-width: none;
		}

		.site-footer__brand-logo {
			width: clamp(200px, 58vw, 235px);
		}

		.site-footer__navigation {
			order: 2;
			margin-top: clamp(2.75rem, 6.5vw, 3.5rem);
		}

		.site-footer__contact {
			order: 3;
			margin-top: clamp(2.75rem, 6.5vw, 3.5rem);
		}

		.site-footer__navigation ul {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.85rem 1.25rem;
		}

		.site-footer__contact dl {
			gap: 1.25rem;
		}

		.site-footer__ecg-bg {
			display: none !important;
		}

		.site-footer__bottom {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
			padding-block: 1.5rem clamp(2rem, 5vw, 2.75rem);
		}

		.site-footer__bottom-links {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
		}

		.site-footer__legal-nav {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.6rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-footer a:not(.site-footer__brand) {
			transition: none !important;
		}

		.footer-monumental-ecg__path {
			transition: none !important;
			stroke-dashoffset: 0 !important;
		}
	}
</style>
