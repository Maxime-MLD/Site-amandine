---
import { Image } from 'astro:assets';
import logoAmandine from '../assets/images/logo-amandine.png';
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
const hasPhone = Boolean(siteConfig.phone && !siteConfig.phone.startsWith('TODO_'));
const hasEmail = Boolean(siteConfig.email && !siteConfig.email.startsWith('TODO_'));
const phoneHref = hasPhone ? `tel:${siteConfig.phone.replace(/[\s.-]/g, '')}` : '#';
const emailHref = hasEmail ? `mailto:${siteConfig.email}` : '#';

const footerNavigation = [
	{ label: 'Accueil', href: '/#accueil' },
	{ label: 'Soins', href: '/#soins' },
	{ label: 'À propos', href: '/#a-propos' },
	{ label: 'Pour qui ?', href: '/#pour-qui' },
	{ label: 'Avis patients', href: '/#avis-patients' },
	{ label: 'FAQ', href: '/#faq' },
	{ label: 'Contact', href: '/#contact' },
] as const;
---

<footer class="site-footer">
	<!-- Monumental Background Cardiogram (Design Statement) -->
	<div class="site-footer__ecg-bg" aria-hidden="true">
		<svg class="site-footer__monumental-ecg" viewBox="0 0 1600 400" fill="none" preserveAspectRatio="none">
			<defs>
				<linearGradient id="monumentalEcgGrad" x1="0%" y1="0%" x2="100%" y2="0%">
					<stop offset="0%" stop-color="#52798a" stop-opacity="0" />
					<stop offset="8%" stop-color="#52798a" stop-opacity="0.35" />
					<stop offset="18%" stop-color="#52798a" stop-opacity="0.85" />
					<stop offset="32%" stop-color="#2c697e" stop-opacity="0.95" />
					<stop offset="50%" stop-color="#f4efe7" stop-opacity="0.9" />
					<stop offset="68%" stop-color="#1b4f62" stop-opacity="0.95" />
					<stop offset="82%" stop-color="#52798a" stop-opacity="0.85" />
					<stop offset="92%" stop-color="#52798a" stop-opacity="0.35" />
					<stop offset="100%" stop-color="#52798a" stop-opacity="0" />
				</linearGradient>
			</defs>
			<path
				class="footer-monumental-ecg__path"
				d="M 0 240 L 720 240 L 740 40 L 760 360 L 780 150 L 800 290 L 815 240 L 925 240 L 945 80 L 965 330 L 980 240 L 1600 240"
				stroke="url(#monumentalEcgGrad)"
				stroke-width="28"
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
		</svg>
	</div>

	<div class="site-footer__inner site-container">
		<div class="site-footer__main">
			<!-- Identity / Brand Column -->
			<div class="site-footer__identity">
				<a class="site-footer__brand" href="/#accueil" aria-label={`${siteConfig.fullName}, retour à l’accueil`}>
					<Image
						class="site-footer__brand-logo"
						src={logoAmandine}
						alt={`${siteConfig.fullName} — Infirmière à domicile`}
						height={84}
						loading="lazy"
						decoding="async"
					/>
				</a>
				<p class="site-footer__place">Montagny et alentours</p>
				<p class="site-footer__promise">
					Soins infirmiers à domicile avec écoute, disponibilité et professionnalisme.
				</p>
				<div class="site-footer__availability">
					<p class="site-footer__heading">Disponibilités</p>
					<p class="site-footer__availability-time">
						Du lundi au samedi<br />
						7h00 — 19h00
					</p>
				</div>
			</div>

			<!-- Navigation Column -->
			<nav class="site-footer__navigation" aria-label="Navigation du pied de page">
				<p class="site-footer__heading">Navigation</p>
				<ul>
					{footerNavigation.map((item) => (
						<li><a href={item.href}>{item.label}</a></li>
					))}
				</ul>
			</nav>

			<!-- Contact Column -->
			<div class="site-footer__contact">
				<p class="site-footer__heading">Contact</p>
				<dl>
					<div class="site-footer__phone">
						<dt>Téléphone</dt>
						<dd>{hasPhone ? <a href={phoneHref}>{siteConfig.phone}</a> : 'À compléter'}</dd>
					</div>
					<div>
						<dt>Email</dt>
						<dd>{hasEmail ? <a href={emailHref}>{siteConfig.email}</a> : 'À compléter'}</dd>
					</div>
					<div>
						<dt>Secteur</dt>
						<dd>Montagny et alentours</dd>
					</div>
				</dl>
			</div>
		</div>

		<!-- Bottom Copyright & Legal Links -->
		<div class="site-footer__bottom">
			<p>© {currentYear} {siteConfig.fullName} — Tous droits réservés.</p>
			<p class="site-footer__credit">
				Site réalisé par
				<a href="https://www.mld-studio.fr" target="_blank" rel="noopener noreferrer">MLD.studio</a>
			</p>
			<nav aria-label="Informations légales">
				<a href="/mentions-legales/">Mentions légales</a>
				<a href="/politique-de-confidentialite/">Politique de confidentialité</a>
			</nav>
		</div>
	</div>
</footer>

<script>
	function initFooterEcg() {
		const path = document.querySelector<SVGPathElement>('.footer-monumental-ecg__path');
		const footer = document.querySelector<HTMLElement>('.site-footer');
		if (!path || !footer) return;

		// Calculate exact SVG path length
		const length = Math.ceil(path.getTotalLength()) || 2200;
		path.style.strokeDasharray = `${length}`;

		// Instant full line without animation on mobile or reduced motion
		const isMobile = window.matchMedia('(max-width: 47.999rem)').matches;
		if (isMobile || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			path.style.strokeDashoffset = '0';
			path.style.strokeDasharray = 'none';
			path.style.transition = 'none';
			return;
		}

		// Initial state: hidden
		path.style.strokeDashoffset = `${length}`;

		// IntersectionObserver to animate once on entry
		const observer = new IntersectionObserver(
			(entries) => {
				const entry = entries[0];
				if (entry.isIntersecting) {
					requestAnimationFrame(() => {
						path.style.transition = 'stroke-dashoffset 3.8s cubic-bezier(0.22, 0.85, 0.36, 1)';
						path.style.strokeDashoffset = '0';
					});
					observer.disconnect();
				}
			},
			{ threshold: 0.1 }
		);

		observer.observe(footer);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initFooterEcg);
	} else {
		initFooterEcg();
	}
</script>

<style>
	.site-footer {
		position: relative;
		overflow: hidden;
		background: var(--bg-dark);
		color: var(--c-ivory);
	}

	/* Ultra-subtle paper grain */
	.site-footer::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image: var(--grain-image);
		background-size: 128px;
		background-repeat: repeat;
		opacity: 0.028;
		pointer-events: none;
	}

	.site-footer__inner {
		position: relative;
		z-index: 1;
	}

	.site-footer__main {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(11rem, 0.72fr) minmax(16rem, 1fr);
		gap: clamp(3.5rem, 7.5vw, 7.5rem);
		padding-block: clamp(5.5rem, 8vw, 9.5rem) clamp(4rem, 5.5vw, 6.5rem);
	}

	.site-footer__identity {
		max-width: 28rem;
	}

	.site-footer__brand,
	.site-footer__brand:hover {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		opacity: 1;
		transform: none;
	}

	.site-footer__brand-logo {
		height: clamp(68px, 5.2vw, 84px);
		width: auto;
		max-width: min(380px, 85vw);
		object-fit: contain;
		display: block;
	}

	.site-footer__place {
		margin-top: 1.6rem;
		color: rgba(244, 239, 231, 0.92);
		font-family: var(--font-heading);
		font-size: 1rem;
		font-weight: 700;
	}

	.site-footer__place::before {
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		margin-right: 0.6rem;
		border-radius: 50%;
		background: var(--c-amber);
		content: '';
		vertical-align: 0.08em;
	}

	.site-footer__promise {
		max-width: 35ch;
		margin-top: 1.15rem;
		color: rgba(244, 239, 231, 0.72);
		font-size: 1rem;
		line-height: 1.7;
	}

	.site-footer__availability {
		margin-top: 1.85rem;
	}

	.site-footer__availability-time {
		margin: 0.35rem 0 0;
		color: var(--c-ivory);
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.45;
	}

	.site-footer__heading,
	.site-footer dt {
		color: var(--c-amber);
		font-family: var(--font-heading);
		font-size: 0.76rem;
		font-weight: 750;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.site-footer__navigation ul {
		display: grid;
		gap: 0.75rem;
		margin: 1.6rem 0 0;
		padding: 0;
		list-style: none;
	}

	.site-footer a:not(.site-footer__brand) {
		position: relative;
		color: rgba(244, 239, 231, 0.82);
		text-decoration: none;
		transition: color 180ms ease;
	}

	.site-footer a:not(.site-footer__brand)::after {
		position: absolute;
		inset: auto 0 -0.2rem;
		height: 1px;
		background: var(--c-amber);
		content: '';
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 180ms ease;
	}

	.site-footer a:not(.site-footer__brand):hover {
		color: var(--color-background);
	}

	.site-footer a:not(.site-footer__brand):hover::after,
	.site-footer a:not(.site-footer__brand):focus-visible::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.site-footer__contact dl {
		display: grid;
		gap: 1.5rem;
		margin: 1.6rem 0 0;
	}

	.site-footer dd {
		margin: 0.35rem 0 0;
		color: var(--c-ivory);
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.45;
		overflow-wrap: anywhere;
	}

	.site-footer__phone dd {
		font-family: var(--font-heading);
		font-size: clamp(1.25rem, 2vw, 1.55rem);
		font-weight: 720;
		letter-spacing: -0.03em;
	}

	.site-footer__phone a {
		color: var(--c-ivory) !important;
	}

	.site-footer__phone a:hover {
		color: var(--c-amber) !important;
	}

	/* Monumental Background Cardiogram (Design Statement) */
	.site-footer__ecg-bg {
		position: absolute;
		inset-inline: 0;
		top: 50%;
		transform: translateY(-50%);
		height: clamp(20rem, 40vw, 30rem);
		pointer-events: none;
		z-index: 0;
		-webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.45) 8%, black 18%, black 82%, rgba(0, 0, 0, 0.45) 92%, transparent 100%);
		mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.45) 8%, black 18%, black 82%, rgba(0, 0, 0, 0.45) 92%, transparent 100%);
	}

	.site-footer__monumental-ecg {
		width: 100%;
		height: 100%;
		display: block;
		overflow: visible;
	}

	.footer-monumental-ecg__path {
		opacity: 0.11;
		filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.22));
	}

	.site-footer__bottom {
		border-top: 1px solid rgba(244, 239, 231, 0.1);
		display: grid;
		grid-template-columns: 1fr auto auto;
		align-items: center;
		gap: 1.75rem 2.5rem;
		padding-block: clamp(2rem, 2.8vw, 2.75rem) clamp(2.5rem, 3.8vw, 3.75rem);
		color: rgba(244, 239, 231, 0.65);
		font-size: 0.875rem;
		line-height: 1.45;
	}

	.site-footer__credit a {
		margin-left: 0.25rem;
		color: rgba(244, 239, 231, 0.88);
		font-weight: 700;
	}

	.site-footer__bottom nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	@media (max-width: 63.999rem) {
		.site-footer__main {
			grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.9fr);
			gap: 4rem 5rem;
		}

		.site-footer__identity {
			grid-column: 1 / -1;
		}

		.site-footer__bottom {
			grid-template-columns: 1fr auto;
		}

		.site-footer__credit {
			grid-column: 1;
			grid-row: 2;
		}

		.site-footer__bottom nav {
			grid-column: 2;
			grid-row: 1 / span 2;
			align-items: flex-end;
			flex-direction: column;
			gap: 0.75rem;
		}
	}

	@media (max-width: 47.999rem) {
		.site-footer__main {
			display: flex;
			gap: 0;
			flex-direction: column;
			padding-block: clamp(4.75rem, 11vw, 6.75rem) clamp(3.25rem, 7vw, 4.75rem);
		}

		.site-footer__identity {
			order: 1;
		}

		.site-footer__brand-logo {
			height: clamp(56px, 13vw, 70px);
		}

		.site-footer__contact {
			order: 2;
			margin-top: clamp(3.25rem, 7.5vw, 4.25rem);
		}

		.site-footer__navigation {
			order: 3;
			margin-top: clamp(3rem, 7vw, 3.75rem);
		}

		.site-footer__contact dl {
			gap: 1.35rem;
		}

		.site-footer__navigation ul {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.85rem 1.25rem;
		}

		.site-footer__ecg-bg {
			height: clamp(14rem, 48vw, 21rem);
			top: 50%;
			transform: translateY(-50%);
			inset-inline: 0;
		}

		.footer-monumental-ecg__path {
			stroke-width: 34;
			opacity: 0.09;
			stroke-dashoffset: 0 !important;
			stroke-dasharray: none !important;
			transition: none !important;
		}

		.site-footer__bottom {
			display: flex;
			align-items: flex-start;
			gap: 1rem;
			flex-direction: column;
			padding-block: 1.75rem clamp(2.25rem, 6vw, 3.25rem);
		}

		.site-footer__credit,
		.site-footer__bottom nav {
			display: flex;
			grid-column: auto;
			grid-row: auto;
			align-items: flex-start;
			gap: 0.75rem;
			flex-direction: column;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-footer a:not(.site-footer__brand) {
			transition: none !important;
		}

		.footer-monumental-ecg__path {
			transition: none !important;
			stroke-dashoffset: 0 !important;
		}
	}
</style>
