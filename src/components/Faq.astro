---
import { faqContent, faqItems } from '../data/content';
---

<section class="faq" id="faq" aria-labelledby="faq-title">
	<div class="faq__inner site-container">
		<!-- Left Column: Title, Intro & Emergency note -->
		<div class="faq__intro-col">
			<p class="faq__eyebrow">{faqContent.eyebrow}</p>
			<h2 id="faq-title" class="faq__title">
				{faqContent.titleLead}{' '}
				<span class="faq__title-accent">{faqContent.titleAccent}</span> ?
			</h2>
			<p class="faq__desc">
				{faqContent.intro}
			</p>

			<!-- Discreet emergency clarification line (no pill/badge) -->
			<p class="faq__emergency">
				<span class="faq__emergency-dot" aria-hidden="true">•</span>
				<span>{faqContent.emergencyNote}</span>
			</p>
		</div>

		<!-- Right Column: Minimalist Accordion List -->
		<div class="faq__accordion-col">
			<ul class="faq-list" role="list">
				{faqItems.map((item, index) => {
					const num = String(index + 1).padStart(2, '0');
					const triggerId = `faq-trigger-${index + 1}`;
					const panelId = `faq-panel-${index + 1}`;

					return (
						<li class="faq-item" data-faq-item data-open="false">
							<h3 class="faq-item__heading">
								<button
									class="faq-item__trigger"
									type="button"
									id={triggerId}
									aria-expanded="false"
									aria-controls={panelId}
									data-faq-trigger
								>
									<span class="faq-item__num">{num}</span>
									<span class="faq-item__question">{item.question}</span>
									<span class="faq-item__icon" aria-hidden="true">
										<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
											<path d="M8 2.5V13.5M2.5 8H13.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
										</svg>
									</span>
								</button>
							</h3>

							<div
								class="faq-item__answer"
								id={panelId}
								role="region"
								aria-labelledby={triggerId}
							>
								<div class="faq-item__answer-inner">
									<p class="faq-item__text">{item.answer}</p>
									{'hasCta' in item && item.hasCta && (
										<div class="faq-item__cta-wrap">
											<a href={item.ctaHref} class="faq-item__cta">
												<span>{item.ctaLabel}</span>
												<svg viewBox="0 0 16 16" fill="none" class="faq-item__cta-arrow" aria-hidden="true">
													<path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
												</svg>
											</a>
										</div>
									)}
								</div>
							</div>
						</li>
					);
				})}
			</ul>
		</div>
	</div>
</section>

<style>
	.faq {
		position: relative;
		overflow: clip;
		background: var(--bg-dark);
		padding-block: var(--section-padding-y);
	}

	/* Ultra-subtle tactile texture grain */
	.faq::after {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--grain-image) 0 0 / 128px repeat;
		opacity: 0.028;
		pointer-events: none;
	}

	.faq__inner {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: clamp(3rem, 6vw, 6.5rem);
		align-items: start;
	}

	/* Left Column: Title & Editorial context */
	.faq__intro-col {
		max-width: 480px;
	}

	.faq__eyebrow {
		margin-bottom: var(--space-label-h2);
		color: var(--c-amber);
		font-family: var(--font-heading);
		font-size: var(--text-small);
		font-weight: 750;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.faq__title {
		color: var(--c-ivory);
		font-family: var(--font-heading);
		font-size: clamp(2.75rem, 4.25vw, 4.5rem);
		font-weight: 700;
		letter-spacing: -0.045em;
		line-height: 1.12;
		text-wrap: balance;
		margin: 0;
	}

	.faq__title-accent {
		display: inline-block;
		color: var(--c-amber);
		background: var(--gradient-amber);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		font-family: var(--font-accent);
		font-size: 1em;
		font-style: italic;
		font-weight: 700;
		letter-spacing: -0.025em;
		text-decoration: none;
		border: none;
		margin-left: 0.04em;
		padding-right: 0.06em;
		margin-right: -0.02em;
	}

	.faq__desc {
		margin-top: var(--heading-paragraph-gap, clamp(1.25rem, 0.93rem + 1.43vw, 2rem));
		color: rgba(244, 239, 231, 0.85);
		font-family: var(--font-heading);
		font-size: clamp(1.025rem, 1.25vw, 1.15rem);
		line-height: 1.65;
		max-width: min(38ch, var(--intro-max-width, 38rem));
	}

	.faq__emergency {
		margin-top: clamp(1.5rem, 2.2vw, 2.25rem);
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		color: rgba(244, 239, 231, 0.92);
		font-family: var(--font-heading);
		font-size: 0.86rem;
		font-weight: 500;
		line-height: 1.45;
		margin-bottom: 0;
	}

	.faq__emergency-dot {
		color: var(--c-amber);
		font-size: 0.95rem;
		line-height: 1;
		user-select: none;
		flex-shrink: 0;
	}

	/* Right Column: Minimalist Accordion List */
	.faq__accordion-col {
		min-width: 0;
	}

	.faq-list {
		list-style: none;
		padding: 0;
		margin: 0;
		border-top: 1px solid rgba(244, 239, 231, 0.18);
	}

	.faq-item {
		border-bottom: 1px solid rgba(244, 239, 231, 0.18);
		transition: background-color 200ms ease;
	}

	.faq-item__heading {
		margin: 0;
		font-size: inherit;
		font-weight: inherit;
	}

	/* Trigger Button */
	.faq-item__trigger {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: clamp(1rem, 2vw, 1.6rem);
		width: 100%;
		padding-block: clamp(1.4rem, 2vw, 1.85rem);
		background: transparent;
		border: 0;
		color: var(--c-ivory);
		text-align: left;
		cursor: pointer;
		transition: color 200ms ease;
	}

	.faq-item__trigger:focus-visible {
		outline: 2px solid var(--c-amber);
		outline-offset: 4px;
		border-radius: 0.25rem;
	}

	.faq-item__num {
		color: var(--c-amber);
		font-family: var(--font-heading);
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		font-variant-numeric: tabular-nums;
		transition: color 200ms ease, transform 200ms ease;
		user-select: none;
		min-width: 1.85rem;
	}

	.faq-item__question {
		color: var(--c-ivory);
		font-family: var(--font-heading);
		font-size: clamp(1.15rem, 1.45vw, 1.375rem);
		font-weight: 500;
		letter-spacing: -0.015em;
		line-height: 1.35;
		transition: color 200ms ease;
	}

	.faq-item__icon {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		color: var(--c-ivory);
		transition: color 200ms ease, transform 250ms cubic-bezier(0.22, 1, 0.36, 1);
		user-select: none;
		flex-shrink: 0;
	}

	.faq-item__icon svg {
		width: 1.05rem;
		height: 1.05rem;
		transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* Hover state on desktop */
	@media (hover: hover) and (pointer: fine) {
		.faq-item__trigger:hover .faq-item__question {
			color: var(--color-background);
		}

		.faq-item__trigger:hover .faq-item__num {
			color: #e4ad5c;
			transform: translateX(1px);
		}

		.faq-item__trigger:hover .faq-item__icon {
			color: var(--c-amber);
			transform: rotate(8deg);
		}
	}

	/* Active Open State */
	.faq-item[data-open="true"] .faq-item__question {
		color: var(--color-background);
	}

	.faq-item[data-open="true"] .faq-item__icon svg {
		transform: rotate(45deg);
	}

	.faq-item[data-open="true"] .faq-item__icon {
		color: var(--c-amber);
	}

	/* CSS Grid expansion animation */
	.faq-item__answer {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 300ms cubic-bezier(0.22, 1, 0.36, 1), opacity 260ms ease;
		opacity: 0;
	}

	.faq-item[data-open="true"] .faq-item__answer {
		grid-template-rows: 1fr;
		opacity: 1;
	}

	.faq-item__answer-inner {
		overflow: hidden;
	}

	.faq-item__text {
		color: rgba(244, 239, 231, 0.90);
		font-family: var(--font-heading);
		font-size: clamp(0.98rem, 1.1vw, 1.05rem);
		font-weight: 450;
		line-height: 1.7;
		margin: 0;
		padding-left: clamp(2.85rem, 3.7vw, 3.45rem);
		padding-right: clamp(1rem, 3vw, 2.5rem);
		padding-bottom: clamp(1.4rem, 2vw, 1.85rem);
		max-width: 54ch;
	}

	.faq-item__cta-wrap {
		padding-left: clamp(2.85rem, 3.7vw, 3.45rem);
		padding-bottom: clamp(1.4rem, 2vw, 1.85rem);
	}

	.faq-item__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.6rem 1.25rem;
		border-radius: 9999px;
		background: var(--c-amber);
		color: var(--c-petrol);
		font-family: var(--font-heading);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition: background-color 200ms ease, transform 200ms ease;
	}

	.faq-item__cta:hover {
		background: #e4ad5c;
		transform: translateX(2px);
	}

	.faq-item__cta-arrow {
		width: 0.95rem;
		height: 0.95rem;
		transition: transform 200ms ease;
	}

	.faq-item__cta:hover .faq-item__cta-arrow {
		transform: translateX(3px);
	}

	/* Responsive Tablet */
	@media (max-width: 63.999rem) {
		.faq {
			padding-block: clamp(3.25rem, 5vw, 4.5rem);
		}

		.faq__inner {
			grid-template-columns: 1fr;
			gap: 3.5rem;
		}

		.faq__intro-col {
			max-width: 100%;
		}

		.faq__desc {
			max-width: 52ch;
		}
	}

	/* Responsive Mobile */
	@media (max-width: 47.999rem) {
		.faq {
			padding-block: 3rem 3.75rem;
		}

		.faq__inner {
			gap: 2.75rem;
		}

		.faq__title {
			font-size: clamp(2.35rem, 11vw, 3.35rem);
		}

		.faq-item__trigger {
			gap: 0.85rem;
			padding-block: 1.25rem;
		}

		.faq-item__num {
			font-size: 0.88rem;
			min-width: 1.5rem;
		}

		.faq-item__question {
			font-size: 1.125rem;
		}

		.faq-item__text {
			padding-left: 0;
			padding-bottom: 1.25rem;
			font-size: 0.98rem;
		}

		.faq-item__cta-wrap {
			padding-left: 0;
			padding-bottom: 1.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-item__answer,
		.faq-item__icon svg,
		.faq-item__trigger,
		.faq-item__cta {
			transition: none !important;
		}
	}
</style>

<script>
	function setupFaqAccordion() {
		const section = document.getElementById('faq');
		if (!section) return;

		const items = Array.from(section.querySelectorAll<HTMLElement>('[data-faq-item]'));
		if (!items.length) return;

		let activeItem: HTMLElement | null = null;

		function setItemState(item: HTMLElement, open: boolean) {
			const trigger = item.querySelector<HTMLButtonElement>('[data-faq-trigger]');
			if (!trigger) return;

			item.setAttribute('data-open', open ? 'true' : 'false');
			trigger.setAttribute('aria-expanded', String(open));
		}

		// Initial state: ensure all closed (requirement 9)
		items.forEach((item) => {
			setItemState(item, false);

			const trigger = item.querySelector<HTMLButtonElement>('[data-faq-trigger]');
			if (!trigger) return;

			trigger.addEventListener('click', () => {
				const isCurrentlyOpen = item.getAttribute('data-open') === 'true';

				// Close previously opened item if it is not the current one
				if (activeItem && activeItem !== item) {
					setItemState(activeItem, false);
				}

				if (isCurrentlyOpen) {
					setItemState(item, false);
					activeItem = null;
				} else {
					setItemState(item, true);
					activeItem = item;
				}
			});
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupFaqAccordion, { once: true });
	} else {
		setupFaqAccordion();
	}

	if (import.meta.hot) {
		import.meta.hot.dispose(() => {});
	}
</script>
