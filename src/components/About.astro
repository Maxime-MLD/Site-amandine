---
import { Image } from 'astro:assets';
import amandinePortrait from '../assets/images/cta/amandine-portrait.png';
import { aboutContent } from '../data/content';
---

<section class="about" id="a-propos" aria-labelledby="about-title">
	<div class="about__inner site-container">
		<div class="about__visual">
			<div class="about__block" aria-hidden="true"></div>
			<div class="about__photo-frame">
				<Image
					class="about__photo"
					src={amandinePortrait}
					width={1024}
					height={1536}
					sizes="(max-width: 47.999rem) 60vw, (max-width: 63.999rem) 34vw, 24rem"
					alt={aboutContent.imageAlt}
					loading="lazy"
					decoding="async"
					draggable="false"
				/>
			</div>
		</div>

		<div class="about__content">
			<p class="about__eyebrow">{aboutContent.eyebrow}</p>

			<h2 id="about-title" class="about__title">
				<span class="about__title-line about__title-line--lead">{aboutContent.title.line1}</span>
				<span class="about__title-line">
					{aboutContent.title.line2Lead}{' '}<em class="about__accent">{aboutContent.title.line2Accent}</em>.
				</span>
			</h2>

			<p class="about__text">
				{aboutContent.paragraph.map((segment) =>
					segment.strong ? <strong>{segment.text}</strong> : <>{segment.text}</>
				)}
			</p>
		</div>
	</div>
</section>

<style>
	.about {
		overflow: clip;
		padding-block: clamp(3.5rem, 5.5vw, 6rem);
		scroll-margin-top: 6rem;
		background: var(--grain-image) 0 0 / 128px repeat, var(--c-offwhite);
		color: var(--c-petrol);
	}

	.about__inner {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
		align-items: center;
		gap: clamp(2.25rem, 3.5vw, 3.75rem);
		/* Keep both columns as one compact, centred group inside the wide container
		   instead of letting them drift to the far edges. */
		max-width: 68rem;
		margin-inline: auto;
	}

	/* --- Left: graphic composition (large petrol block as a graphic backdrop with
	   the photo framed on top — designed for a real, non-cut-out photograph) --- */
	.about__visual {
		position: relative;
		width: 100%;
		max-width: 30rem;
		justify-self: center;
		aspect-ratio: 4 / 5;
		/* Shared offset so the petrol block and the photo stay exactly the same size,
		   the block simply shifted up-left behind the photo (premium stacked look). */
		--about-offset: clamp(1.75rem, 3vw, 2.25rem);
	}

	.about__block {
		position: absolute;
		/* Same size as the photo, offset to the top-left (peeks out top + left). */
		inset: 0 var(--about-offset) var(--about-offset) 0;
		border-radius: 24px;
		background: var(--grain-image) 0 0 / 120px repeat, var(--c-petrol);
		box-shadow: 0 24px 50px rgb(18 59 74 / 16%);
	}

	.about__photo-frame {
		position: absolute;
		/* Same size as the block, offset to the bottom-right (sits in front). */
		inset: var(--about-offset) 0 0 var(--about-offset);
		overflow: hidden;
		border-radius: 24px;
		background: var(--c-ivory);
		box-shadow: 0 26px 52px rgb(18 59 74 / 24%);
	}

	.about__photo {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 22%;
		user-select: none;
	}

	/* --- Right: editorial text --- */
	.about__content {
		max-width: 40rem;
	}

	.about__eyebrow {
		margin-bottom: 1rem;
		color: var(--c-amber);
		font-family: var(--font-heading);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.about__title {
		color: var(--c-petrol);
		font-family: var(--font-heading);
		font-size: clamp(2.3rem, 3.15vw, 3.3rem);
		font-weight: 680;
		letter-spacing: -0.035em;
		line-height: 1.08;
	}

	.about__title-line {
		display: block;
	}

	/* Keep "Je suis Amandine Gauthier," on a single line (never split the name). */
	.about__title-line--lead {
		white-space: nowrap;
	}

	.about__accent {
		color: var(--c-amber);
		font-family: var(--font-accent);
		font-size: 1em;
		font-style: italic;
		font-weight: 500;
		letter-spacing: 0;
		/* Playfair italic carries a wider left side-bearing than Manrope, so pull
		   it back a touch to keep "votre infirmière" reading as one phrase. */
		margin-left: -0.05em;
	}

	.about__text {
		max-width: 50ch;
		margin-top: clamp(1.5rem, 2.2vw, 1.9rem);
		color: color-mix(in srgb, var(--c-steel) 90%, var(--c-petrol));
		font-size: clamp(1.08rem, 1.25vw, 1.22rem);
		line-height: 1.8;
	}

	.about__text strong {
		color: var(--c-petrol);
		font-weight: 600;
	}

	@media (max-width: 63.999rem) {
		.about__inner {
			grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
			gap: clamp(1.75rem, 3vw, 2.5rem);
		}

		.about__visual {
			max-width: 22rem;
		}

		.about__title {
			font-size: clamp(1.8rem, 3.4vw, 2.6rem);
		}
	}

	@media (max-width: 47.999rem) {
		.about {
			padding-block: 3.5rem;
		}

		.about__inner {
			grid-template-columns: 1fr;
			gap: clamp(2.25rem, 7vw, 3rem);
		}

		.about__visual {
			max-width: 25rem;
			aspect-ratio: 4 / 5;
			--about-offset: 1.5rem;
		}

		.about__block {
			border-radius: 22px;
		}

		.about__photo-frame {
			border-radius: 22px;
		}

		.about__content {
			max-width: none;
		}

		/* Keep the title on exactly two lines (name never split): size line 1 to the
		   viewport so "Je suis Amandine Gauthier," always fits on one line. */
		.about__title {
			font-size: clamp(1.3rem, 6.5vw, 1.9rem);
		}

		.about__text {
			max-width: none;
			font-size: 1.06rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.about__photo {
			filter: none;
		}
	}
</style>
