---
import { Image } from 'astro:assets';
import contactImage from '../assets/images/methode/contact.webp';
import organisationImage from '../assets/images/methode/organisation-rendez-vous.webp';
import soinImage from '../assets/images/methode/votre-soin.webp';
import { methodeContent, methodeSteps } from '../data/content';

const themes = ['ivory', 'offwhite', 'sand'] as const;
const images = [contactImage, organisationImage, soinImage] as const;
const cards = methodeSteps.map((step, index) => ({
	...step,
	theme: themes[index],
	image: images[index],
}));
---

<section class="methode" id="methode" aria-labelledby="methode-title" data-methode>
	<div class="site-container">
		<header class="methode__header" data-methode-header>
			<p class="methode__eyebrow">
				{methodeContent.eyebrow}
			</p>
			<h2 id="methode-title" class="methode__title">
				<span class="methode__title-line">Comment se déroule</span>
				<span class="methode__title-line">
					votre <em class="methode__title-accent">accompagnement</em> ?
				</span>
			</h2>
			<p class="methode__intro">{methodeContent.intro}</p>
		</header>
	</div>

	<div class="methode__pin" data-methode-pin>
		<div class="methode__deck" data-methode-deck>
			{cards.map((card) => (
				<article
					class:list={['methode-card', `methode-card--${card.theme}`]}
					data-methode-card
				>
					<span class="methode-card__tab">
						Étape <span class="methode-card__tab-sep" aria-hidden="true">/</span> <strong class="methode-card__tab-num">{card.number}</strong>
					</span>

					<div class="methode-card__body">
						<div class="methode-card__text">
							<span class="methode-card__step-badge" aria-hidden="true">{card.number}</span>
							<h3 class="methode-card__title">{card.title}</h3>
							<p class="methode-card__desc">{card.description}</p>
						</div>

						<div class="methode-card__media" aria-hidden="true">
							<Image
								src={card.image}
								width={1200}
								height={800}
								sizes="(max-width: 767px) calc(100vw - 64px), (max-width: 1023px) 42vw, 540px"
								alt=""
								loading="eager"
								decoding="async"
							/>
						</div>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.methode {
		position: relative;
		background: var(--grain-image) 0 0 / 128px repeat, var(--bg-secondary);
		padding-block: var(--section-padding-y) 0;
	}

	.methode__header {
		max-width: min(65rem, 100%);
		margin-inline: auto;
		text-align: center;
	}

	.methode__eyebrow {
		margin-bottom: var(--space-label-h2);
		color: var(--c-amber);
		font-family: var(--font-heading);
		font-size: var(--text-small);
		font-weight: 750;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.methode__title {
		color: var(--c-petrol);
		font-family: var(--font-heading);
		font-size: clamp(2.75rem, 5.8vw, 5.25rem);
		font-weight: 680;
		letter-spacing: -0.04em;
		line-height: 1.08;
		text-wrap: balance;
	}

	.methode__title-line {
		display: block;
	}

	.methode__title-accent {
		display: inline-block;
		color: var(--c-amber);
		background: var(--gradient-amber);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		font-family: var(--font-accent);
		font-size: 1.08em;
		font-style: italic;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.15;
		text-decoration: none;
		border: none;
		margin-left: 0.02em;
		padding-right: 0.08em;
		padding-bottom: 0.28em;
		margin-bottom: -0.28em;
	}

	.methode__intro {
		max-width: var(--intro-max-width, 38rem);
		margin: var(--heading-paragraph-gap, clamp(1.25rem, 0.93rem + 1.43vw, 2rem)) auto 0;
		color: var(--c-steel);
		font-family: var(--font-heading);
		font-size: clamp(1.125rem, 1.4vw, 1.3rem);
		line-height: 1.6;
		text-wrap: balance;
	}

	/* -- Deck: base = normal flow (no-JS / reduced-motion fallback) -- */
	.methode__pin {
		margin-top: clamp(2.5rem, 4vw, 3.5rem);
		padding-bottom: var(--section-padding-y);
	}

	.methode__deck {
		--tab-w: clamp(9.5rem, 12vw, 11rem);
		--tab-1: 1.5rem;
		--tab-2: calc(1.5rem + var(--tab-w) + 0.75rem);
		--tab-3: calc(1.5rem + (var(--tab-w) + 0.75rem) * 2);
		display: grid;
		gap: clamp(3rem, 4vw, 3.5rem);
		width: min(76%, 66rem);
		margin-inline: auto;
		padding-top: 3rem;
	}

	.methode-card {
		position: relative;
		display: flex;
		min-height: clamp(22rem, 42vw, 26rem);
		flex-direction: column;
		justify-content: center;
		border-radius: 1.75rem;
		border: 1px solid rgba(18, 59, 74, 0.08);
		padding: clamp(2.25rem, 3.2vw, 3rem);
		box-shadow:
			0 18px 45px rgba(18, 59, 74, 0.07),
			0 4px 14px rgba(18, 59, 74, 0.03);
		background:
			var(--grain-image) 0 0 / 128px repeat,
			linear-gradient(145deg, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 65%),
			var(--card-bg);
		color: var(--card-text);
	}

	.methode-card--ivory {
		--card-bg: var(--c-ivory);
		--card-text: var(--c-petrol);
		--card-muted: #3a5460;
		--tab-left: var(--tab-1);
	}

	.methode-card--offwhite {
		--card-bg: var(--c-offwhite);
		--card-text: var(--c-petrol);
		--card-muted: #3a5460;
		--tab-left: var(--tab-2);
	}

	.methode-card--sand {
		--card-bg: #eae3d6;
		--card-text: var(--c-petrol);
		--card-muted: #3a5460;
		--tab-left: var(--tab-3);
	}

	/* Filing-card tab */
	.methode-card__tab {
		position: absolute;
		bottom: calc(100% - 1px);
		left: var(--tab-left);
		z-index: 2;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		width: var(--tab-w);
		height: 2.65rem;
		padding: 0 1.15rem;
		border-radius: 0.85rem 0.85rem 0 0;
		border: 1px solid rgba(18, 59, 74, 0.08);
		border-bottom: none;
		background:
			var(--grain-image) 0 0 / 128px repeat,
			linear-gradient(145deg, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0) 70%),
			var(--card-bg);
		color: var(--card-text);
		font-family: var(--font-heading);
		font-size: 0.8rem;
		font-weight: 750;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.methode-card__tab-sep {
		color: var(--c-steel);
		opacity: 0.6;
	}

	.methode-card__tab-num {
		color: var(--c-amber);
		font-weight: 800;
	}

	.methode-card__body {
		display: grid;
		grid-template-columns: minmax(0, 0.98fr) minmax(0, 1.02fr);
		align-items: center;
		gap: clamp(1.5rem, 2.5vw, 2.5rem);
		width: 100%;
	}

	.methode-card__text {
		min-width: 0;
	}

	.methode-card__step-badge {
		display: block;
		margin-bottom: 0.35rem;
		color: var(--c-amber);
		font-family: var(--font-accent);
		font-size: 1.18rem;
		font-style: italic;
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.01em;
	}

	.methode-card__title {
		color: var(--card-text);
		font-family: var(--font-heading);
		font-size: clamp(1.95rem, 2.8vw, 2.65rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.1;
		text-wrap: balance;
	}

	.methode-card__desc {
		max-width: 38ch;
		margin-top: clamp(0.95rem, 1.4vw, 1.25rem);
		color: var(--card-muted);
		font-family: var(--font-heading);
		font-size: clamp(1.05rem, 1.3vw, 1.2rem);
		line-height: 1.65;
	}

	.methode-card__media {
		height: clamp(18rem, 29vw, 24.5rem);
		overflow: hidden;
		border-radius: clamp(0.85rem, 1.1vw, 1.05rem);
		border: 1px solid rgba(18, 59, 74, 0.07);
		background: rgb(255 255 255 / 40%);
		box-shadow: 0 12px 32px rgba(18, 59, 74, 0.08);
	}

	.methode-card__media :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	/* -- Pinned stack (all widths, motion allowed, JS ready) -- */
	@media (prefers-reduced-motion: no-preference) {
		[data-methode-ready] .methode__pin {
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			width: 100%;
			height: 100svh;
			margin-top: clamp(1.5rem, 3vw, 2.5rem);
			padding-top: 96px;
			padding-bottom: 1rem;
			overflow: hidden;
			box-sizing: border-box;
		}

		[data-methode-ready] .methode__deck {
			display: block;
			position: relative;
			width: min(76%, 66rem);
			height: min(72svh, 37.5rem);
			margin-inline: auto;
			padding-top: 0;
			border-radius: 1.75rem;
			box-shadow:
				0 18px 45px rgba(18, 59, 74, 0.07),
				0 4px 14px rgba(18, 59, 74, 0.03);
		}

		[data-methode-ready] .methode-card {
			position: absolute;
			inset: 0;
			height: 100%;
			min-height: 0;
			will-change: transform;
			-webkit-backface-visibility: hidden;
			backface-visibility: hidden;
			transform: translate3d(0, 0, 0);
			box-shadow: none;
		}

		[data-methode-ready] .methode-card--ivory {
			z-index: 1;
		}

		[data-methode-ready] .methode-card--offwhite {
			z-index: 2;
		}

		[data-methode-ready] .methode-card--sand {
			z-index: 3;
		}
	}

	/* -- Tablet -- */
	@media (max-width: 63.999rem) {
		.methode__deck {
			--tab-w: 8.5rem;
			--tab-1: 1rem;
			--tab-2: calc(1rem + var(--tab-w) + 0.5rem);
			--tab-3: calc(1rem + (var(--tab-w) + 0.5rem) * 2);
			width: min(88%, calc(100% - 48px));
		}

		[data-methode-ready] .methode__deck {
			width: min(88%, calc(100% - 48px));
			height: min(66svh, 32rem);
		}

		.methode-card {
			padding: 2rem 1.75rem;
		}

		.methode-card__body {
			gap: 1.5rem;
		}

		.methode-card__media {
			height: clamp(13rem, 23vw, 17rem);
		}

		.methode-card__desc {
			max-width: 40ch;
		}
	}

	@media (prefers-reduced-motion: no-preference) and (max-width: 63.999rem) {
		[data-methode-ready] .methode__pin {
			padding-top: calc(84px + 1.25rem);
			padding-bottom: 1.25rem;
		}
	}

	/* -- Mobile -- */
	@media (max-width: 47.999rem) {
		.methode {
			padding-top: 3.5rem;
		}

		.methode__title {
			font-size: clamp(2.2rem, 8.8vw, 2.9rem);
			line-height: 1.04;
		}

		.methode__deck {
			--tab-w: clamp(5.6rem, 25vw, 6.75rem);
			--tab-1: 0.5rem;
			--tab-2: calc(0.5rem + var(--tab-w) + 0.35rem);
			--tab-3: calc(0.5rem + (var(--tab-w) + 0.35rem) * 2);
			width: min(var(--container), calc(100% - 32px));
			gap: 3rem;
		}

		.methode-card {
			min-height: 0;
			padding: 1.15rem 1.15rem;
			border-radius: 1.35rem;
			background:
				linear-gradient(145deg, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0) 65%),
				var(--card-bg);
		}

		.methode-card__tab {
			height: 2.25rem;
			padding: 0 0.65rem;
			font-size: 0.6875rem;
			letter-spacing: 0.04em;
			border-radius: 0.7rem 0.7rem 0 0;
			background:
				linear-gradient(145deg, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 70%),
				var(--card-bg);
		}

		.methode-card__body {
			grid-template-columns: 1fr;
			gap: 0.65rem;
		}

		.methode-card__step-badge {
			display: none;
		}

		.methode-card__media {
			height: clamp(7.5rem, 24vw, 9.5rem);
			border-radius: 0.85rem;
		}

		.methode-card__title {
			font-size: clamp(1.25rem, 5vw, 1.55rem);
			line-height: 1.15;
		}

		.methode-card__desc {
			margin-top: 0.3rem;
			font-size: clamp(0.85rem, 3.3vw, 0.92rem);
			line-height: 1.42;
		}
	}

	@media (prefers-reduced-motion: no-preference) and (max-width: 47.999rem) {
		[data-methode-ready] .methode__pin {
			padding-top: calc(84px + 1.25rem);
			padding-bottom: 1.25rem;
		}

		[data-methode-ready] .methode__deck {
			width: min(var(--container), calc(100% - 32px));
			height: clamp(20.5rem, 48svh, 24.5rem);
			border-radius: 1.35rem;
		}
	}
</style>
