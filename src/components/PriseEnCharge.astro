---
import { priseEnChargeContent } from '../data/content';
---

<section class="prise-en-charge" id="prise-en-charge" aria-labelledby="prise-en-charge-title">
	<div class="site-container">
		<!-- Section Header -->
		<header class="prise-en-charge__header">
			<p class="prise-en-charge__eyebrow">{priseEnChargeContent.eyebrow}</p>
			<h2 id="prise-en-charge-title" class="prise-en-charge__title">
				{priseEnChargeContent.title.lead}{' '}
				<span class="prise-en-charge__title-accent">{priseEnChargeContent.title.accent}</span>.
			</h2>
			<p class="prise-en-charge__intro">{priseEnChargeContent.intro}</p>
		</header>

		<!-- 3 Open Editorial Columns -->
		<div class="prise-en-charge__grid">
			{priseEnChargeContent.pillars.map((pillar) => (
				<article class="prise-en-charge__pillar">
					<span class="prise-en-charge__number">{pillar.number}</span>
					<span class="prise-en-charge__accent" aria-hidden="true" />
					<h3 class="prise-en-charge__pillar-title">{pillar.title}</h3>
					<p class="prise-en-charge__pillar-desc">{pillar.description}</p>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.prise-en-charge {
		position: relative;
		overflow: clip;
		background: var(--bg-primary);
		padding-block: var(--section-padding-y);
	}

	.prise-en-charge__header {
		max-width: 52rem;
	}

	.prise-en-charge__eyebrow {
		margin-bottom: var(--space-label-h2, 1rem);
		color: var(--c-amber);
		font-family: var(--font-heading);
		font-size: var(--text-small, 0.82rem);
		font-weight: 750;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.prise-en-charge__title {
		max-width: 26ch;
		color: var(--c-petrol);
		font-family: var(--font-heading);
		font-size: clamp(2.75rem, 4.25vw, 4.5rem);
		font-weight: 700;
		letter-spacing: -0.045em;
		line-height: 1.15;
		text-wrap: balance;
	}

	.prise-en-charge__title-accent {
		display: inline-block;
		color: var(--c-amber);
		background: var(--gradient-amber);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		font-family: var(--font-accent);
		font-size: 1em;
		font-style: italic;
		font-weight: 700;
		letter-spacing: -0.025em;
		text-decoration: none;
		border: none;
		margin-left: 0.04em;
		padding-right: 0.06em;
		margin-right: -0.02em;
	}

	.prise-en-charge__intro {
		max-width: var(--intro-max-width, 38rem);
		margin-top: var(--heading-paragraph-gap, clamp(1.25rem, 0.93rem + 1.43vw, 2rem));
		color: var(--c-steel);
		font-family: var(--font-heading);
		font-size: clamp(1.05rem, 1.25vw, 1.2rem);
		line-height: 1.65;
		text-wrap: balance;
	}

	/* 3-Column Open Grid Layout */
	.prise-en-charge__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(2.5rem, 4vw, 4.5rem);
		margin-top: clamp(3.5rem, 5.5vw, 5.5rem);
	}

	.prise-en-charge__pillar {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		background: transparent;
		border: none;
		box-shadow: none;
		border-radius: 0;
		padding: 0;
	}

	/* Fines séparations verticales ouvertes entre les colonnes sur grand écran */
	@media (min-width: 64rem) {
		.prise-en-charge__pillar:not(:last-child)::after {
			content: '';
			position: absolute;
			top: 0.5rem;
			bottom: 0.5rem;
			right: calc(-0.5 * clamp(2.5rem, 4vw, 4.5rem));
			width: 1px;
			background: rgba(18, 59, 74, 0.09);
		}
	}

	/* Grand numéro éditorial */
	.prise-en-charge__number {
		display: block;
		font-family: var(--font-heading);
		font-size: clamp(3.25rem, 4.8vw, 4.75rem);
		font-weight: 450;
		line-height: 1;
		letter-spacing: -0.04em;
		font-feature-settings: 'tnum';
		color: rgba(18, 59, 74, 0.38);
		margin-bottom: clamp(1rem, 1.5vw, 1.4rem);
	}

	/* Accent graphique : trait horizontal fin ambre */
	.prise-en-charge__accent {
		display: block;
		width: 38px;
		height: 2px;
		border-radius: 2px;
		background: var(--c-amber);
		margin-bottom: clamp(1rem, 1.4vw, 1.25rem);
	}

	/* Titre de bloc */
	.prise-en-charge__pillar-title {
		color: var(--c-petrol);
		font-family: var(--font-heading);
		font-size: clamp(1.25rem, 1.5vw, 1.45rem);
		font-weight: 650;
		letter-spacing: -0.025em;
		line-height: 1.3;
		margin-bottom: clamp(0.75rem, 1vw, 1rem);
	}

	/* Texte de bloc */
	.prise-en-charge__pillar-desc {
		color: var(--c-steel);
		font-size: clamp(0.95rem, 1.05vw, 1.05rem);
		line-height: 1.7;
		text-wrap: pretty;
		margin: 0;
	}

	/* Tablette et Mobile : passage en stack vertical noble et aéré */
	@media (max-width: 63.999rem) {
		.prise-en-charge__grid {
			grid-template-columns: 1fr;
			gap: 0;
			margin-top: clamp(2.75rem, 5vw, 3.75rem);
		}

		.prise-en-charge__pillar {
			padding-block: clamp(2rem, 5vw, 2.75rem);
		}

		.prise-en-charge__pillar:not(:last-child) {
			border-bottom: 1px solid rgba(18, 59, 74, 0.09);
		}

		.prise-en-charge__pillar:first-child {
			padding-top: 0;
		}

		.prise-en-charge__pillar:last-child {
			padding-bottom: 0;
		}

		.prise-en-charge__pillar-desc {
			max-width: 48ch;
		}
	}
</style>
