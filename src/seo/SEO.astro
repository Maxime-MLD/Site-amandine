---
import { siteConfig } from '../config/site';
import { seoConfig } from './config';
import type { SEOProps } from './types';

interface Props extends SEOProps {}

const {
	title,
	description,
	canonical = Astro.url.href,
	image = seoConfig.defaultImage,
	imageAlt = seoConfig.defaultImageAlt,
	robots = seoConfig.defaultRobots,
	schema,
} = Astro.props;

const canonicalUrl = new URL(canonical, Astro.site ?? Astro.url.origin).href;
const imageUrl = image ? new URL(image, Astro.site ?? Astro.url.origin).href : undefined;
const twitterCard = imageUrl ? 'summary_large_image' : 'summary';
const schemaJson = schema ? JSON.stringify(schema) : undefined;

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const hasGoogleSiteVerification =
	typeof googleSiteVerification === 'string' &&
	googleSiteVerification.length > 0 &&
	!googleSiteVerification.startsWith('TODO_');
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
{hasGoogleSiteVerification && (
	<meta name="google-site-verification" content={googleSiteVerification} />
)}
<meta name="author" content={seoConfig.author} />
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang={siteConfig.locale} href={canonicalUrl} />

<meta property="og:type" content="website" />
<meta property="og:locale" content="fr_FR" />
<meta property="og:site_name" content={seoConfig.siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
{imageUrl && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

<!-- Favicon & App Icons -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />

<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<link rel="manifest" href="/site.webmanifest" />

<link
	rel="mask-icon"
	href="/safari-pinned-tab.svg"
	color="#d99a3e"
/>

<meta name="theme-color" content="#123b4a" />
<meta name="msapplication-TileColor" content="#123b4a" />
<meta name="msapplication-config" content="/browserconfig.xml" />

{schemaJson && <script is:inline type="application/ld+json" set:html={schemaJson} />}
